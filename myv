<name>sys_data_source_c0ac90731b48a4500d02b9dcdd4bcb15</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_data_source"&gt;&lt;sys_data_source action="INSERT_OR_UPDATE"&gt;&lt;batch_size&gt;1000&lt;/batch_size&gt;&lt;category/&gt;&lt;connection_alias/&gt;&lt;connection_override_last_success_time/&gt;&lt;connection_timeout&gt;0&lt;/connection_timeout&gt;&lt;connection_url/&gt;&lt;connection_url_parameters/&gt;&lt;csv_delimiter/&gt;&lt;data_in_single_column&gt;false&lt;/data_in_single_column&gt;&lt;data_loader&gt;&lt;![CDATA[(function loadData(import_set_table) {

    // HELPER FUNCTIONS
    // Helper function which iterates over array of SNOW Events and inserts them to the Import Set Table
    var insertSnowEvents = function(arrayOfSnowEvents) {
        if (Array.isArray(arrayOfSnowEvents)) {
            for (m = 0; m &lt; arrayOfSnowEvents.length; m++) {
                var curSnowEvent = arrayOfSnowEvents[m];
                import_set_table.insert(curSnowEvent);
            }
        }
    };

    // Initializing Script Includes
    var httpsHelpers = new HttpsHelpers();
    var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();
    var epmQueryGetters = new EpmQueryGetters();

    // VARS FOR EPM SETTINGS
    var epmSettings = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_settings');
    var allEpmSettings = epmQueryGetters.getEpmSettings(epmSettings);
    if (allEpmSettings === null) {
        gs.error("invalid configuration");
        return;
    }
    var password = allEpmSettings.password;
    var username = allEpmSettings.username;
    var epmBaseUrl = allEpmSettings.epmBaseUrl;
    var isManEnabled = allEpmSettings.isManEnabled; // Man is a JIT Request
	var isElvEnabled = allEpmSettings.isElvEnabled;
    var setIDs = allEpmSettings.setIDs;
    var lastrun = new GlideDateTime(allEpmSettings.lastrun); 
    var fullSync = allEpmSettings.fullSync; // whether lastrun time in EPM Settings is set to empty
    var dateTo = new GlideDateTime(gs.minutesAgoStart(0)); //calling time
    
    // RETRIEVE &amp; STORE TOKEN/URL FROM EPM API
    var response = httpsHelpers.makeHttpsCall(epmBaseUrl.concat('/EPM/API/Auth/EPM/Logon'), 'POST', '', username, password, "EPMSNOW");
    if (response.getStatusCode() != 200) {
        gs.error("Cyberark EPM Plugin: " + "Failed to authenticate to EPM" + "\nURL: " + epmBaseUrl);
        return;
    }
    var responseBody = JSON.parse(response.getBody());
    
    // STORING TOKEN &amp; URL FOR USE IN ALL OTHER HTTPS CALLS
    var epmToken = responseBody.EPMAuthenticationResult;
    var epmManagerUrl = responseBody.ManagerURL;

    // GET Detailed Manual Request Events
    var manRawEvents = epmQueryGetters.getDetailedRawEvents(setIDs, epmToken, epmManagerUrl, fullSync == null? null : lastrun);
