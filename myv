<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;false&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;true&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;x_cya_cyberark_epm_cyberark_epm_request&lt;/collection&gt;&lt;condition/&gt;&lt;description/&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="x_cya_cyberark_epm_cyberark_epm_request"&gt;request_state=in_process^stage=requested^EQ&lt;item display_value="Approved" endquery="false" field="request_state" goto="false" newquery="false" operator="=" or="false" value="in_process"/&gt;&lt;item display_value="Requested" endquery="false" field="stage" goto="false" newquery="false" operator="=" or="false" value="requested"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;CyberArk EPM Request Create Policy Rule&lt;/name&gt;&lt;order&gt;50&lt;/order&gt;&lt;priority&gt;50&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous) {
	var serviceNowUtils = new ServiceNowUtils();
	
	try {
		current.setWorkflow(false); // disables execution of other business rules
	} catch (error) {
		gs.warn("Unable to set Workflow to false : " + error);
		// Expected output: ReferenceError: nonExistentFunction is not defined
		// (Note: the exact output may be browser-dependent)
	}

	var propertyValue = gs.getProperty('x_cya_cyberark_epm.disable_async_api_calls');
	var disableAsyncApiCalls = (propertyValue? propertyValue : 'not defined');
	gs.info("*****x_cya_cyberark_epm.disable_async_api_calls: " + (disableAsyncApiCalls? disableAsyncApiCalls : 'not defined'));
	
	if (["true", "enabled"].includes(disableAsyncApiCalls)) {
		gs.info("CyberArk EPM Request Create Policy Rule: SYNC Method");


		// Initializing Script Includes
		var httpsHelpers = new HttpsHelpers();
		var policyBodyBuilders = new PolicyBodyBuilders();
		var epmQueryGetters = new EpmQueryGetters();

		// Generic Vars
		var computer = '';
		var eventId = '';
		var eventType = '';
		var filepath='';
		var hash='';
		var justification = '';
		var packageName='';
		var publisher='';
		var setId = '';
		var sourceName = '';
		var username = '';
		var agentId = '';
		var eventRow = '';
		
		eventType = current.request_type;
		var gr = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_metadata');
		gr.addQuery('cyberark_epm_request', current.getUniqueValue());
		while (setId == '') {
			gr.query();

			while (gr.next()) {
				eventId = String(gr.getValue('eventid'));
				sourceName = gr.getValue('sourcename');
				packageName = gr.getValue('packagename');
				computer = String(gr.getValue('computer'));
				setId = String(gr.getValue('setid'));
				justification = (gr.getValue('justification'));
				publisher = (gr.getValue('publisher'));
				hash = (gr.getValue('hash'));
				filepath = (gr.getValue('filepath'));
				username = gr.getValue('user');
				agentId = gr.getValue('agentid');
				eventRow = gr.getValue('eventrow');
			}
		}

		var epmBaseUrl;
		var epmUsername;
		var password;
		
		var epmSettings = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_settings');
		epmSettings.query();
		while (epmSettings.next()) {
			epmBaseUrl = String(epmSettings.getValue('epm_login_url'));
			epmUsername = epmSettings.getValue('epm_api_username');
			password = epmSettings.epm_api_password.getDecryptedValue();
		}
		gs.info("Policy run entered...");
		// Log on to EPM
		var response = httpsHelpers.logonForPolicy(epmBaseUrl.concat('/EPM/API/Auth/EPM/Logon'), 'POST', '', epmUsername, password, "EPMSNOW", '');
		if (response.getStatusCode() != 200){
			serviceNowUtils.logError(current, "Cyberark EPM Plugin: " + "Failed to authenticate to EPM in Business Rule with status code " + response.getStatusCode());
			return;
		}
		var responseBody = JSON.parse(response.getBody()); 
		gs.info("Policy request body: " + responseBody.String);
		var epmToken = responseBody.EPMAuthenticationResult;
		var epmEventUrl = responseBody.ManagerURL;
		var name = (eventType == "ManualRequest" ? "JIT Policy SNOW " + gs.minutesAgo(0) : "Elevation Request for " + username + " - " + gs.minutesAgo(0));
		gs.info("Policy request name: " + name);
		var sanitizedJustification = justification.replace(/[^\d\w]/gi, '');
		gs.info("Policy request justification: " + sanitizedJustification);
		var body = "";
		var method = "POST";
		gs.info("***EventType: " + eventType);
		if(eventType == "ManualRequest" ) {
			body = policyBodyBuilders.jitBody2(name,sanitizedJustification, username, agentId, current);
			epmEventUrl = epmEventUrl.concat('/EPM/API/Sets/', setId, "/Policies/Server");
		} else if (eventType == "ElevationRequest") {
			gs.info("**Elevation_Options: [" + current.elevation_options + "]");
			if (current.elevation_options === "AddToPolicy") {
				gs.info("***current.application_policy: " + current.application_policy);
				var referencePolicyRow = epmQueryGetters.getReferencePolicyBySysId(current.application_policy);
				gs.info("*** Application Policy: " + referencePolicyRow.getValue("policyid"));
				epmEventUrl = epmEventUrl.concat('/EPM/API/Sets/', setId, "/Policies/Server/" + referencePolicyRow.getValue("policyid"));
				body = policyBodyBuilders.addToPolicyBody(epmEventUrl, epmToken, current, JSON.parse(gs.base64Decode(eventRow)));
				method = "PUT";
			} else if (current.elevation_options === "AddToAppGroup") {
				gs.info("***current.application.group: " + current.application_group);
				var appGroupPolicyRow = epmQueryGetters.getReferencePolicyBySysId(current.application_group);
				gs.info("*** Application Group Policy: " + appGroupPolicyRow.getValue("policyid"));
				epmEventUrl = epmEventUrl.concat('/EPM/API/Sets/', setId, "/Policies/ApplicationGroups/" + appGroupPolicyRow.getValue("policyid"));
				body = policyBodyBuilders.addToPolicyBody(epmEventUrl, epmToken, current, JSON.parse(gs.base64Decode(eventRow)));
				method = "PUT";
			} else {
				aggregatedBy = JSON.parse(gs.base64Decode(eventRow)).aggregatedBy;
				body = {"Filter" : "aggregatedBy EQ \"" + aggregatedBy + "\"", "SendEmail": false, "Elevation": 1};
				epmEventUrl = epmEventUrl.concat('/EPM/API/Sets/', setId, "/Policies/Server/Elevate");
			}
		}
		gs.info("**** Policy request bodyBuilt: " + JSON.stringify(body));
		var createEpmPolicy = httpsHelpers.logonForPolicy(epmEventUrl, method, epmToken, '', '',"EPMSNOW", body); 
		code = createEpmPolicy.getStatusCode();
		
		if (code === 403) {
			gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in Business Rules: Create Policy Rule\nRetrying in 60 seconds');
			var recall = true;
			var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();		
			while (recall) {
				epmQueryGeneralHelpers.wait(60000);
				createEpmPolicy = httpsHelpers.logonForPolicy(epmEventUrl, method, epmToken, '', '',"EPMSNOW", body);
				code = createEpmPolicy.getStatusCode();
				if (code !== 403) {
					recall = false;
					gs.info('Cyberark EPM Plugin: EPM API Limit retry successful');
				}
			}
		}

		if (code === 201 || code == 200) {
			current.setValue("state",1);
			current.setValue("request_state","closed_complete");
			current.setValue("stage","closed_complete");
			current.setValue("approval","approved");
			gs.info("Cyberark EPM Plugin: EPM Policy  Created " + createEpmPolicy.getBody());
		} else {
			current.setValue("request_state","closed_incomplete");
			current.setValue("stage","closed_incomplete");
