				gs.error('Error in setApprovers: ' + error.message);
			}
			gs.info('OVERRIDE: Finishing runTransformScript');
		}
	}

})(source, map, log, target);]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_transform_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;edwarD.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-09-03 13:40:23&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_id&gt;fc67a4ee3b8f8f105cee54ac24e45afa&lt;/sys_id&gt;&lt;sys_mod_count&gt;2&lt;/sys_mod_count&gt;&lt;sys_name&gt;onBefore&lt;/sys_name&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_transform_script_fc67a4ee3b8f8f105cee54ac24e45afa&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edwarD.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-09-03 14:12:37&lt;/sys_updated_on&gt;&lt;when&gt;onBefore&lt;/when&gt;&lt;/sys_transform_script&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;fc67a4ee3b8f8f105cee54ac24e45afa&lt;/id&gt;&lt;sys_created_by&gt;edwarD.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-09-03 13:40:23&lt;/sys_created_on&gt;&lt;sys_id&gt;de08a8ee3b8f8f105cee54ac24e45a19&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;edwarD.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-09-03 13:40:23&lt;/sys_updated_on&gt;&lt;table&gt;sys_transform_script&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
