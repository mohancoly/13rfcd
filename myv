<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.EpmQueryGetters&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;true&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;EpmQueryGetters&lt;/name&gt;&lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var EpmQueryGetters = Class.create();
EpmQueryGetters.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    // !!!WARNING!!! SNOW does not provide detailed error logs for script includes
    // If you move the function into CyberArk EPM Query it will be easier to de-bug

    checkRestrictRequestStageChanges: function() {
		var serviceNowUtils = new ServiceNowUtils();
        try {
            var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
            epmSettings.query();
            if (epmSettings.next()) {
				
				if (epmSettings.getValue("restrict_request_stage_changes") == "1") {
					return 'true';
				}

			}
         } catch (ex) {
            serviceNowUtils.logError(null, '*** error in query!', ex);
			gs.error("*** An error occurred: " + ex.message);
        } finally {
            if (epmSettingsObj != null &amp;&amp; epmSettingsObj.isManEnabled === 0 &amp;&amp; epmSettingsObj.isElvEnabled === 0) {
                serviceNowUtils.logError(null, "Cyberark EPM Plugin: Either Just In Time Request or Elevation Requests needs to be enabled in CyberArk EPM Settings");
            }

        }
        return 'false';
    },

    getEpmSettings: function(glideRecord, validateEnabledEPMSets) {
        var loggingService = new LoggingService();
		var serviceNowUtils = new ServiceNowUtils();
        var epmSettingsObj = null;
        try {
            var epmSettings = glideRecord;
            epmSettings.query();
            if (epmSettings.next()) {
                var lcs = epmSettings.getValue("enabled_epm_sets");
				if (lcs === null &amp;&amp; validateEnabledEPMSets == true) {
					serviceNowUtils.logError(epmSettings, "CyberArk EPM Plugin: Enabled EPM Sets in EPM Settings is undefined...Please set value and re-run");
				}
				else {
					epmSettingsObj = {};
					epmSettingsObj.commaSeperatedSets = lcs;
					epmSettingsObj.commaSeperatedSetsArray = lcs === null? [] :epmSettingsObj.commaSeperatedSets.split(",");
					epmSettingsObj.epmBaseUrl = epmSettings.getValue("epm_login_url");
					epmSettingsObj.isElvEnabled = epmSettings.getValue("enable_elevation_requests");
					epmSettingsObj.isManEnabled = epmSettings.getValue("enable_just_in_time_requests");
					epmSettingsObj.password = epmSettings.epm_api_password.getDecryptedValue();
					epmSettingsObj.username = epmSettings.getValue("epm_api_username");
					epmSettingsObj.useISPSSOauth = epmSettings.getValue("use_ispss_oauth") == '1';
					epmSettingsObj.ispssEpmTenantUrl = epmSettings.getValue("ispss_epm_tenant_url");
					epmSettingsObj.oauthEntityProfile = epmSettings.getValue("oauth_entity_profile");
					epmSettingsObj.restrict_request_stage_changes = epmSettings.getValue("restrict_request_stage_changes") == '1';
					
					epmSettingsObj.setIDs = [];

					// Log to App Logs if username or password are undefined
					loggingService.credentials(epmSettingsObj.username, epmSettingsObj.password);

					if (epmSettings.getValue("last_run")) {
						epmSettingsObj.lastrun = epmSettings.getValue("last_run");
						epmSettingsObj.fullSync = false;
					} else {
						epmSettingsObj.lastrun = new GlideDateTime();
						epmSettingsObj.fullSync = true;
					}

					for (i = 0; i &lt; epmSettingsObj.commaSeperatedSetsArray.length; i++) {
						var epmTenantData = new GlideRecordSecure("x_cya_cyberark_epm_cyberark_epm_tenant_data");
						if(epmTenantData.get(epmSettingsObj.commaSeperatedSetsArray[i])) 
							epmSettingsObj.setIDs.push(epmTenantData.getValue("epm_set_id"));
					}
				}
			}
         } catch (ex) {
            epmSettingsObj = null;
            serviceNowUtils.logError(null, 'error in query!', ex);
			// Log the base error message
			gs.error("An error occurred: " + ex.message);
        } finally {
            if (epmSettingsObj != null &amp;&amp; epmSettingsObj.isManEnabled === 0 &amp;&amp; epmSettingsObj.isElvEnabled === 0) {
                serviceNowUtils.logError(null, "Cyberark EPM Plugin: Either Just In Time Request or Elevation Requests needs to be enabled in CyberArk EPM Settings");
            }
        }
        return epmSettingsObj;
    },
	
	// Helper function to get detailed list of events for JIT requests (matching lastrun query if passed)
    getDetailedRawEvents: function(setids, epmToken, epmManagerUrl, lastrun) {
        // Initializing script includes
        var httpsHelpers = new HttpsHelpers();
		var serviceNowUtils = new ServiceNowUtils();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var enableJustInTimeRequests = false;
		epmSettings.query();
		while (epmSettings.next()) {
			enableJustInTimeRequests = epmSettings.getValue('enable_just_in_time_requests');
		}

		if (enableJustInTimeRequests) {
			var detailedEvents = new Array();

			var filtertext = "eventType IN ManualRequest";

			if (lastrun !== undefined &amp;&amp; lastrun !== null) {
				//get events for JIT requests based on the last run query
				var last_run = (new Date(lastrun.getNumericValue()).toISOString()).replace(".000Z", "Z");
				//var filtertext = "eventType IN ManualRequest AND arrivalTime GE \"" + last_run + "\"";
				filtertext = filtertext + " AND arrivalTime GE " + last_run; 
			} else {
				gs.info("last run field is empty. Pulling all events from EPM that do not exist in CyberArk Metadata/EPM Requests");
			}

			var filter = {
				"filter": filtertext
			};
		
			//get events that match filter query
			for (i = 0; i &lt; setids.length; i++) {
				var curSetId = setids[i];
				var curRawEventUrl = epmManagerUrl.concat("/EPM/API/Sets/", curSetId, "/Events/Search");
			var rawEvents = httpsHelpers.makeHttpsPostCall(curRawEventUrl, 'POST', epmToken, filter);
				if (rawEvents.getStatusCode() === 403) {
					gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in GET RAW EVENTS\nRetrying in 60 seconds');
					var recall = true;
					var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();
					while (recall) {
						epmQueryGeneralHelpers.wait(60000);
						rawEvents = httpsHelpers.makeHttpsPostCall(curRawEventUrl, 'POST', epmToken, filter);
						if (rawEvents.getStatusCode() !== 403) {
							recall = false;
							gs.info('Cyberark EPM Plugin: EPM API Limit retry successful');
						}
					}
				}
				if (rawEvents.getStatusCode() === 200) {
					//parse get detailed events response
					var response = rawEvents.getBody();
					var parsedDetailedEvents = JSON.parse(response);
					var eventsList = parsedDetailedEvents.events;
					var eventCount = parsedDetailedEvents.returnedCount; // hard limit of 250 events, parameter is limit 1000
					if (eventCount != 0 &amp;&amp; Array.isArray(eventsList)) {
						for (j = 0; j &lt; eventsList.length; j++) {
							if (eventsList[j].processed != true) {
							eventsList[j].SetId = curSetId;
							detailedEvents.push(eventsList[j]);      
							}
						}
					}
				} else {
					serviceNowUtils.logError(null, "Cyberark EPM Plugin: " + "Failed to getDetailedRawEvents" + "\nURL: " + curRawEventUrl + "\nStatusCode: " + rawEvents.getStatusCode());
					return null;        
				}
			}
		}

        return detailedEvents;
    },

	// Helper function to get detailed list of events for JIT requests (matching lastrun query if passed)
	getAggregatedEvents: function(setids, epmToken, epmManagerUrl, lastrun) {
		// Initializing script includes
		var httpsHelpers = new HttpsHelpers();
		var serviceNowUtils = new ServiceNowUtils();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var enabledElevationRequests = false;
		epmSettings.query();
		while (epmSettings.next()) {
			enabledElevationRequests = epmSettings.getValue('enable_elevation_requests');
		}

		var aggregatedEvents = new Array();

		if (enabledElevationRequests) {
			var filtertext = "eventType IN ElevationRequest";

			if (lastrun !== undefined &amp;&amp; lastrun !== null) {
				//get events for JIT requests based on the last run query
				var last_run = (new Date(lastrun.getNumericValue()).toISOString()).replace(".000Z", "Z");
				filtertext = filtertext + " AND arrivalTime GE " + last_run; 
			} else {
				gs.info("last run field is empty. Pulling all events from EPM that do not exist in CyberArk Metadata/EPM Requests");
			}

			var filter = {
				"filter": filtertext
			};

			//get events that match filter query
			for (i = 0; i &lt; setids.length; i++) {
				var curSetId = setids[i];
				var curRawEventUrl = epmManagerUrl.concat("/EPM/API/Sets/", curSetId, "/events/aggregations/search");
				var rawEvents = httpsHelpers.makeHttpsPostCall(curRawEventUrl, 'POST', epmToken, filter);
				if (rawEvents.getStatusCode() === 403) {
					gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in GET AGGREGATED EVENTS\nRetrying in 60 seconds');
					var recall = true;
					var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();
					while (recall) {
						epmQueryGeneralHelpers.wait(60000);
						rawEvents = httpsHelpers.makeHttpsPostCall(curRawEventUrl, 'POST', epmToken, filter);
						if (rawEvents.getStatusCode() !== 403) {
							recall = false;
							gs.info('Cyberark EPM Plugin: EPM API Limit retry successful');
						}
					}
				}
				if (rawEvents.getStatusCode() === 200) {
					//parse get aggregated events response
					var response = rawEvents.getBody();
					var parsedEvents = JSON.parse(response);
					var eventsList = parsedEvents.events;
					var eventCount = parsedEvents.returnedCount; // hard limit of 250 events, parameter is limit 1000
					if (eventCount != 0 &amp;&amp; Array.isArray(eventsList)) {
						for (j = 0; j &lt; eventsList.length; j++) {
							if (eventsList[j].processed != true) {
								eventsList[j].SetId = curSetId;
								aggregatedEvents.push(eventsList[j]);      
							}
						}
					}
				} else {
					serviceNowUtils.logError(null, "Cyberark EPM Plugin: " + "Failed to getAggregatedEvents" + "\nURL: " + curRawEventUrl + "\nStatusCode: " + rawEvents.getStatusCode());
					return null;        
				}
			}

		}

		return aggregatedEvents;
	},

	// Helper function to get of policies and app groups
    getReferencePolicies: function(setids, epmToken, epmManagerUrl) {

        // Initializing script includes
        var httpsHelpers = new HttpsHelpers();
		var serviceNowUtils = new ServiceNowUtils();

		// Helper function which iterates over array of SNOW Pol;icies and inserts them to the Import Set Table
		var fetchPolicies = function(referencePolicies, policyType, query, filter) {
			// Fetch Policies
            var curRawEventUrl = epmManagerUrl.concat(query);
            var rawEvents = httpsHelpers.makeHttpsPostCall(curRawEventUrl, 'POST', epmToken, filter);
            if (rawEvents.getStatusCode() === 403) {
                gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in getReferencePolicies\nRetrying in 60 seconds');
                var recall = true;
				var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();
                while (recall) {
                    epmQueryGeneralHelpers.wait(60000);
                    rawEvents = httpsHelpers.makeHttpsPostCall(curRawEventUrl, 'POST', epmToken, filter);
                    if (rawEvents.getStatusCode() !== 403) {
                        recall = false;
                        gs.info('Cyberark EPM Plugin: EPM API Limit retry successful');
                    }
                }
            }
            if (rawEvents.getStatusCode() === 200) {
                //parse get detailed events response
                var response = rawEvents.getBody();
                var parsedPolicies = JSON.parse(response);
                var policiesList = parsedPolicies.Policies;
                var count = parsedPolicies.filteredCount;
                if (count != 0 &amp;&amp; Array.isArray(policiesList)) {
                    for (j = 0; j &lt; policiesList.length; j++) {
                        policiesList[j].SetId = curSetId;
						policiesList[j].PolicyType = policyType;
                        referencePolicies.push(policiesList[j]);      
                    }
                }
            } else {
                serviceNowUtils.logError(null, "Cyberark EPM Plugin: " + "Failed to getReferencePolicies" + "\nURL: " + curRawEventUrl + "\nStatusCode: " + rawEvents.getStatusCode());
                return null;        
            }
		};


		var referencePolicies = new Array();
        for (i = 0; i &lt; setids.length; i++) {
			var curSetId = setids[i];
			fetchPolicies(referencePolicies, "Policy", String.concat("/EPM/API/Sets/", curSetId, "/Policies/Server/Search"), {"filter": "isActive EQ true AND action EQ 3 AND policyType EQ 11"});
			fetchPolicies(referencePolicies, "Application Group", String.concat("/EPM/API/Sets/", curSetId, "/Policies/ApplicationGroups/Search"), {"filter": "isActive EQ false AND action EQ 0"});
        }
        return referencePolicies;
    },

	// Helper function to get of policiy by SysID
    getReferencePolicyBySysId: function(keyvalue) {
		gs.info("***Getting ReferencePolicy with sys_id = " + keyvalue);
		var gr = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_reference_policies');
		gr.addQuery('sys_id', keyvalue);
		gr.query();
		if (gr.next()) {
			gs.info("***FOUND*** " + gr);
			return gr;
		}
		return null;
	},

    type: 'EpmQueryGetters'
});]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;drew.lockliear@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2021-08-05 17:09:13&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_id&gt;87395c6d87bdbc50dea3da083cbb3573&lt;/sys_id&gt;&lt;sys_mod_count&gt;233&lt;/sys_mod_count&gt;&lt;sys_name&gt;EpmQueryGetters&lt;/sys_name&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy&gt;read&lt;/sys_policy&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_87395c6d87bdbc50dea3da083cbb3573&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-06-29 23:50:27&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;87395c6d87bdbc50dea3da083cbb3573&lt;/id&gt;&lt;sys_created_by&gt;Edward.Nunez&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2024-10-09 16:26:51&lt;/sys_created_on&gt;&lt;sys_id&gt;dace8b8f1bcd1e509be20d01cd4bcbd0&lt;/sys_id&gt;&lt;sys_mod_count&gt;1&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-06-29 17:01:15&lt;/sys_updated_on&gt;&lt;table&gt;sys_script_include&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
