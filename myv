<name>sys_script_include_d53982383baf6e105cee54ac24e45a3e</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.AsyncEpmQueryGetters&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;AsyncEpmQueryGetters&lt;/name&gt;&lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var AsyncEpmQueryGetters = Class.create();
AsyncEpmQueryGetters.prototype = {
    initialize: function() {
    },

	startRetrieveSets: function(logonOutput) {
		var asyncHttpsHelpers = new AsyncHttpsHelpers();

		// VARS FOR EPM SETTINGS
		var useISPSSOauth = false;
		var oauthEntityProfile = null;


		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		epmSettings.query();
		while (epmSettings.next()) {
			useISPSSOauth = epmSettings.getValue("use_ispss_oauth") == 1;
			oauthEntityProfile = epmSettings.getValue("oauth_entity_profile");
		}

		gs.info("useISPSSOauth: " + useISPSSOauth);

		logonResult = JSON.parse(logonOutput);

		if (useISPSSOauth === true) {
			epmManagerUrl = logonResult.tenantUrl;
			gs.info("TENANTURL: " + epmManagerUrl);
			asyncHttpsHelpers.makeISPSSHttpsPostCall(epmManagerUrl.concat('/EPM/API/Sets'), 'GET', oauthEntityProfile, null, "EPM-RETRIEVE-SETS");
		} else {
			var epmToken = logonResult.EPMAuthenticationResult;
			var epmManagerUrl = logonResult.ManagerURL;
			asyncHttpsHelpers.makeHttpsPostCall(epmManagerUrl.concat('/EPM/API/Sets'), 'GET', epmToken, null, "EPM-RETRIEVE-SETS");
		}

	},

    retrieveSets: function(current) {
		gs.info("=&gt; retrieveSets");
		var asyncHttpsHelpers = new AsyncHttpsHelpers();
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();

		gs.info(current.payload);
		var xmlDoc = new XMLDocument2();
		xmlDoc.parseXML(current.payload);
