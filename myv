<name>sys_script_include_c17c506187fdbc50dea3da083cbb35b1</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.EpmQueryGeneralHelpers&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;true&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;EpmQueryGeneralHelpers&lt;/name&gt;&lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var EpmQueryGeneralHelpers = Class.create();
EpmQueryGeneralHelpers.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	// Helper Function to pause exicution of code for X milliseconds
	wait : function(ms) {
		var unixtime_ms = new Date().getTime();
		while(new Date().getTime() &lt; unixtime_ms + ms) {
			// Comment to hide error in IDE
		}
    },
	
	// Helper function which takes in an Array of Raw Events and returns and Array of SNOW Events
	buildSnowEvents: function(arrayOfRawEvents){
		var arrayOfSnowEvents = [];
		
		for (m = 0; m &lt; arrayOfRawEvents.length; m++){
			var snowEvent = {};
			var curRawEvent = arrayOfRawEvents[m];

			snowEvent.FileQualifier = curRawEvent.fileQualifier;
			snowEvent.EventType = curRawEvent.eventType; 
			snowEvent.Publisher = curRawEvent.publisher;
			snowEvent.Processed = false;
			snowEvent.EventId = curRawEvent.arrivalTime;
			snowEvent.SetId = curRawEvent.SetId;
			snowEvent.AgentId = curRawEvent.agentId;

			if (curRawEvent.eventType == "ElevationRequest") {
				snowEvent.Hash = curRawEvent.hash.slice(6);
				snowEvent.Computer = curRawEvent.lastEventComputerName;
				snowEvent.Justification = curRawEvent.lastEventJustification;
				snowEvent.SourceName = curRawEvent.lastEventSourceName;
				snowEvent.User = curRawEvent.lastEventUserName;
				snowEvent.FilePath = curRawEvent.fileLocation;
				snowEvent.ApplicationType = curRawEvent.applicationType;
				snowEvent.PackageName = curRawEvent.lastEventDisplayName;
				snowEvent.EventRow = gs.base64Encode(JSON.stringify(curRawEvent));
				snowEvent.TotalEvents = curRawEvent.totalEvents;
				gs.info("ROW:" + snowEvent.EventRow);
			} else {
				snowEvent.Hash = curRawEvent.hash;
				snowEvent.Computer = curRawEvent.computerName;
				snowEvent.Justification = curRawEvent.justification;
				snowEvent.SourceName = curRawEvent.sourceName;
				snowEvent.User = curRawEvent.userName;
				snowEvent.FilePath = curRawEvent.filePath;
				snowEvent.ApplicationType = curRawEvent.displayName;
				snowEvent.PackageName = curRawEvent.packageName;
				snowEvent.EventRow = ""; // gs.base64Encode(JSON.stringify(curRawEvent));
			}

			arrayOfSnowEvents.push(snowEvent);
	
		}
		return arrayOfSnowEvents;
	},
														
	// Helper function which takes in an Array of Raw Events and returns and Array of SNOW Events
	buildSnowPolicies: function(arrayOfPolicies){
		var arrayOfSnowPolicies = [];
		
		for (m = 0; m &lt; arrayOfPolicies.length; m++){
			var snowPolicy = {};
			var curPolicy = arrayOfPolicies[m];
			snowPolicy.u_set_id = curPolicy.SetId;
			snowPolicy.u_policy_id = curPolicy.PolicyId;
			snowPolicy.u_policy_name = curPolicy.PolicyName;
			snowPolicy.u_policy_type = curPolicy.PolicyType;
			snowPolicy.u_included_in_recent_import = true;
			arrayOfSnowPolicies.push(snowPolicy);
	
		}
		return arrayOfSnowPolicies;
