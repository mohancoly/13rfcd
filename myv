<name>sys_script_a4f5e6361bc1da509be20d01cd4bcb74</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;true&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;false&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;x_cya_cyberark_epm_cyberark_epm_request&lt;/collection&gt;&lt;condition/&gt;&lt;description/&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition/&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;CyberArk EPM Automatic Approval&lt;/name&gt;&lt;order&gt;50&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous /*null when async*/) {

	current.setWorkflow(false); // disables execution of other business rules

	// Get settings
    var epmSettings = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_settings');
	var enabledTicketingValidation = false;
	var enabledAutomaticApprovalForJIT = false;
	var enabledAutomaticApprovalForElev = false;
    epmSettings.query();
    while (epmSettings.next()) {
        enabledTicketingValidation = epmSettings.getValue('enable_ticketing_validation');
		enabledAutomaticApprovalForJIT = epmSettings.getValue('enable_automatic_approval');
		enabledAutomaticApprovalForElev = epmSettings.getValue('enable_automatic_approval_for_elevation_requests');
    }

	// gs.clearProperty('x_cya_cyberark_epm.enable_app_elevation_setting');
	var appElevationSettingEnabled = gs.getProperty('x_cya_cyberark_epm.enable_app_elevation_setting');

	if (!gs.nil(current.requested_for) &amp;&amp; enabledTicketingValidation == true &amp;&amp; current.ticket_number) {
		gs.info("Ticketing Enabled and Ticket was entered : " + current.ticket_number + "(" 
		+ enabledAutomaticApprovalForJIT + "/" + enabledAutomaticApprovalForElev + ")");

		if ((enabledAutomaticApprovalForJIT == true &amp;&amp; current.request_type == "ManualRequest") || (appElevationSettingEnabled &amp;&amp; enabledAutomaticApprovalForElev == true &amp;&amp; current.request_type == "ElevationRequest")) {

			gs.info("Validating Automatic Approval based on Ticket");

			if (current.ticket_number.startsWith("INC") ) {
				// Incident Validation
				var incidentsList = new GlideRecord('incident');
				gs.info("*** QUERY: " + 'active=true^GOTOnumber=' + current.ticket_number + '^state=2^caller_id=' + current.requested_for.sys_id);
				incidentsList.addEncodedQuery('active=true^GOTOnumber=' + current.ticket_number + '^state=2^caller_id=' + current.requested_for.sys_id);
				incidentsList.query();
				if (incidentsList.hasNext()) {
					gs.info("Ticketing Validation: INCIDENT Ticket Found with the query... proceeding to Auto-Approval");
					current.request_state = "in_process";
					current.setWorkflow(true); // enables execution for Create Policy Business Rule
					current.update();
				} else {
					gs.info("Ticketing Validation: NO TICKET FOUND");
				}
			} else {
				if (current.ticket_number.startsWith("CHG") ) {
					// Incident Validation
					var changesList = new GlideRecord('change_request');
					// active=true^state=-1^start_date&lt;=javascript:gs.now()^end_date&gt;=javascript:gs.now()
					// active=true^state=-1^start_date&lt;=javascript:gs.dateGenerate('2024-11-08','18:00:18')^end_date&gt;=javascript:gs.dateGenerate('2024-11-08','18:00:18')^GOTOnumber=CHG0000015^assigned_to=5ee3ed16db5172001d8cd49fdf9619bd
					var now = new GlideDateTime().getValue();
					gs.info("*** QUERY: " + 'active=true^state=-1^start_date&lt;=' + now + '^end_date&gt;=' + now + '^GOTOnumber=' + current.ticket_number + '^assigned_to=' + current.requested_for.sys_id);
					changesList.addEncodedQuery('active=true^state=-1^start_date&lt;=' + now + '^end_date&gt;=' + now + '^GOTOnumber=' + current.ticket_number);
					changesList.query();
					if (changesList.hasNext()) {
						gs.info("Ticketing Validation: CHANGE_REQUEST Ticket Found with the query... proceeding to Auto-Approval");
						current.request_state = "in_process";
						current.setWorkflow(true); // enables execution for Create Policy Business Rule
						current.update();
					} else {
						gs.info("Ticketing Validation: NO TICKET FOUND");
					}
				}
			}

		}
	}

})(current, previous);]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;Edward.Nunez&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2024-10-08 18:53:06&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;a4f5e6361bc1da509be20d01cd4bcb74&lt;/sys_id&gt;&lt;sys_mod_count&gt;42&lt;/sys_mod_count&gt;&lt;sys_name&gt;CyberArk EPM Automatic Approval&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_a4f5e6361bc1da509be20d01cd4bcb74&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-09-16 15:28:40&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;after&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=a4f5e6361bc1da509be20d01cd4bcb74"/&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;a4f5e6361bc1da509be20d01cd4bcb74&lt;/id&gt;&lt;sys_created_by&gt;Edward.Nunez&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2024-10-08 18:53:05&lt;/sys_created_on&gt;&lt;sys_id&gt;32a6e6361bc1da509be20d01cd4bcb8f&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;Edward.Nunez&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2024-10-08 18:53:05&lt;/sys_updated_on&gt;&lt;table&gt;sys_script&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
