<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;true&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;false&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;ecc_queue&lt;/collection&gt;&lt;condition/&gt;&lt;description/&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="ecc_queue"&gt;topicSTARTSWITHEPM-CREATE-POLICY:^queue=input^stateINready,error^EQ&lt;item endquery="false" field="topic" goto="false" newquery="false" operator="STARTSWITH" or="false" value="EPM-CREATE-POLICY:"/&gt;&lt;item display_value="input" endquery="false" field="queue" goto="false" newquery="false" operator="=" or="false" value="input"/&gt;&lt;item display_value="ready,error" endquery="false" field="state" goto="false" newquery="false" operator="IN" or="false" value="ready,error"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;EPM-CREATE-POLICY&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	var elements = current.topic.split(":");
	var currentRequestId = elements[1];

	current.state = "processed";
	current.processed = new GlideDateTime();
	// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
	current.status = 1;
	current.setWorkflow(false);
	current.update();
	current.setWorkflow(true);	

	var xmlDoc = new XMLDocument2();
	xmlDoc.parseXML(current.payload);
	var http_status_code = xmlDoc.getNode("//parameters/parameter[@name='http_status_code']").getAttribute("value");
	var output = xmlDoc.getNodeText("//results/result/output");

	var currentRequest = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_request');
	if (currentRequest.get(currentRequestId)) {

		if (http_status_code == 403) {
			gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in Business Rules: Create Policy Rule\nRetrying in 60 seconds');
			var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();		
			epmQueryGeneralHelpers.wait(60000);
			var retry = new GlideRecord('ecc_queue');
			retry.initialize();
			retry.topic = current.response_to.topic;
			retry.name = current.response_to.name;
			retry.queue = 'output';
			retry.agent = current.response_to.agent;
			retry.payload = current.response_to.payload;
			retry.source = current.response_to.source;
			retry.target = current.response_to.target;
			retry.state = 'ready';
			retry.insert();
			current.state = "error";
			current.processed = new GlideDateTime();
			// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
			current.status = 1;
			current.setWorkflow(false);
			current.update();
			current.setWorkflow(true);	
		} else {
			if (http_status_code == 201 || http_status_code == 200) {
				currentRequest.setValue("state",1);
				currentRequest.setValue("request_state","closed_complete");
				currentRequest.setValue("stage","closed_complete");
				currentRequest.setValue("approval","approved");
				gs.info("Cyberark EPM Plugin: EPM Policy  Created " + output); // + createEpmPolicy.getBody());
			} else {
				currentRequest.setValue("request_state","closed_incomplete");
				currentRequest.setValue("stage","closed_incomplete");
				currentRequest.setValue("approval","rejected");
				currentRequest.setValue("short_description","EPM failed to be create policy");       
				currentRequest.short_description="EPM Policy failed to be created";       
				gs.warn("Cyberark EPM Plugin: EPM Policy not Created: [" + http_status_code + "] Response From EPM: " + output);
			}

			// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
			currentRequest.status = 1;
			currentRequest.setWorkflow(false);
			currentRequest.update();
			currentRequest.setWorkflow(true);	
		}
	}

})(current, previous);
]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;edward.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-09-12 17:18:55&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;9c8088083b407e105cee54ac24e45a52&lt;/sys_id&gt;&lt;sys_mod_count&gt;9&lt;/sys_mod_count&gt;&lt;sys_name&gt;EPM-CREATE-POLICY&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_9c8088083b407e105cee54ac24e45a52&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-10-16 17:07:30&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;after&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=9c8088083b407e105cee54ac24e45a52"/&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;9c8088083b407e105cee54ac24e45a52&lt;/id&gt;&lt;sys_created_by&gt;edward.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-09-12 17:18:55&lt;/sys_created_on&gt;&lt;sys_id&gt;d01488083b407e105cee54ac24e45a49&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-09-12 17:18:55&lt;/sys_updated_on&gt;&lt;table&gt;sys_script&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
