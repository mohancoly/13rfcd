	// Helper function to get detailed list of events for JIT requests (matching lastrun query if passed)
    getRawEvents: function(setids, useISPSSOauth, oauthEntityProfile, epmToken, epmManagerUrl, lastrun, import_set_id, lastrun_offset) {
        // Initializing script includes
        var asyncHttpsHelpers = new AsyncHttpsHelpers();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var enableJustInTimeRequests = false;
		var enableElevationRequests = false;
		epmSettings.query();
		while (epmSettings.next()) {
			enableJustInTimeRequests = epmSettings.getValue('enable_just_in_time_requests') == true;
			enableElevationRequests = epmSettings.getValue('enable_elevation_requests') == true;
		}

		gs.info("ENABLE ELEVATION REQUESTS: " + enableElevationRequests);

		var last_run = (new Date(lastrun.getNumericValue()).toISOString()).replace(".000Z", "Z");
		var filtertext = "";
		var detailedFilter = {};
		var aggregatedFilter = {};

		if (enableJustInTimeRequests) {
			var detailedEvents = new Array();

			filtertext = "eventType IN ManualRequest";

			if (lastrun !== undefined &amp;&amp; lastrun !== null) {
				//get events for JIT requests based on the last run query
				//var filtertext = "eventType IN ManualRequest AND arrivalTime GE \"" + last_run + "\"";
				filtertext = filtertext + " AND arrivalTime GE " + last_run; 
			} else {
				gs.info("last run field is empty. Pulling all events from EPM that do not exist in CyberArk Metadata/EPM Requests");
			}

			detailedFilter = {
				"filter": filtertext
			};
		}

		if (enableElevationRequests) {
			filtertext = "eventType IN ElevationRequest";

			if (lastrun !== undefined &amp;&amp; lastrun !== null) {
				//get events for JIT requests based on the last run query
				filtertext = filtertext + " AND arrivalTime GE " + last_run; 
			} else {
				gs.info("last run field is empty. Pulling all events from EPM that do not exist in CyberArk Metadata/EPM Requests");
			}

			aggregatedFilter = {
				"filter": filtertext
			};
		}
			
		for (i = 0; i &lt; setids.length; i++) {
			var curSetId = setids[i];
			var curDetailedRawEventUrl = epmManagerUrl.concat("/EPM/API/Sets/", curSetId, "/Events/Search");
			var curAggregatedRawEventUrl = epmManagerUrl.concat("/EPM/API/Sets/", curSetId, "/events/aggregations/search");

			if (enableJustInTimeRequests) {
				if (useISPSSOauth == true) {
					asyncHttpsHelpers.makeISPSSHttpsPostCall(curDetailedRawEventUrl, 'POST', oauthEntityProfile, detailedFilter, "EPM-IMPORT-02-DETL:" + (i+1) + ":" + setids.length + ":" + curSetId + ":" + lastrun_offset + ":" + import_set_id);

				} else {
					asyncHttpsHelpers.makeHttpsPostCall(curDetailedRawEventUrl, 'POST', epmToken, detailedFilter, "EPM-IMPORT-02-DETL:" + (i+1) + ":" + setids.length + ":" + curSetId + ":" + lastrun_offset + ":" + import_set_id);
				}
			}

			if (enableElevationRequests) {
				if (useISPSSOauth == true) {
					asyncHttpsHelpers.makeISPSSHttpsPostCall(curAggregatedRawEventUrl, 'POST', oauthEntityProfile, aggregatedFilter, "EPM-IMPORT-02-AGGR:" + (i+1) + ":" + setids.length + ":" + curSetId  + ":" + lastrun_offset + ":" + import_set_id);
				} else {
					asyncHttpsHelpers.makeHttpsPostCall(curAggregatedRawEventUrl, 'POST', epmToken, aggregatedFilter, "EPM-IMPORT-02-AGGR:" + (i+1) + ":" + setids.length + ":" + curSetId  + ":" + lastrun_offset + ":" + import_set_id);

				}
			}

		}

    },

