<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.AsyncHttpsHelpers&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;AsyncHttpsHelpers&lt;/name&gt;&lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var AsyncHttpsHelpers = Class.create();
AsyncHttpsHelpers.prototype = {

	// storageMap : new Map(),

    initialize: function() {
		// this.storageMap = new Map();
    },

	debugStorageMap: function() {
		gs.debug("*** variable storageMap: " + JSON.stringify(AsyncHttpsHelpers.storageMap));
	},

	getStoredValue: function(variableName) {
		return AsyncHttpsHelpers.storageMap[variableName];
	},

	startLogon: function(correlationId) {
		var epmQueryGetters = new EpmQueryGetters();

		// VARS FOR EPM SETTINGS
		var epmBaseUrl = "";
		var password = "";
		var username = "";
		var useISPSSOauth = false;
		var ispssEpmTenantUrl = "";
		var oauthEntityProfile = "";

		var epmSettings = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_settings');
		epmSettings.query();
		while (epmSettings.next()) {
			epmBaseUrl = epmSettings.getValue("epm_login_url");
			password = epmSettings.epm_api_password.getDecryptedValue();
			username = epmSettings.getValue("epm_api_username");
			useISPSSOauth = epmSettings.getValue("use_ispss_oauth") == 1;
			ispssEpmTenantUrl = epmSettings.getValue("ispss_epm_tenant_url");
			oauthEntityProfile = epmSettings.getValue("oauth_entity_profile");
		}


		var allEpmSettings = epmQueryGetters.getEpmSettings(epmSettings, false);
		if (allEpmSettings === null) {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(current, "startLogon: invalid configuration");
			return;
		}


		gs.info("useISPSSOauth: " + useISPSSOauth);

		if (useISPSSOauth === true) {
			this.logonISPSS(ispssEpmTenantUrl, oauthEntityProfile, "EPMSNOW", correlationId); // url, username, password, appid, correlationId
		} else {
			this.logon(epmBaseUrl.concat('/EPM/API/Auth/EPM/Logon'), username, password, "EPMSNOW", correlationId); // url, username, password, appid, correlationId
		}

	},

	startScheduledImport: function() {
		var impSet = new GlideRecordSecure('sys_import_set');
		impSet.initialize();
		impSet.short_description = 'ASYNC Scheduled Import';
		impSet.table_name = 'x_cya_cyberark_epm_import_table'; // Replace with your actual import set table name
		impSet.mode = 'asynchronous';
		var impSet_id = impSet.insert();

		var epmQueryGetters = new EpmQueryGetters();

		// VARS FOR EPM SETTINGS
		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var allEpmSettings = epmQueryGetters.getEpmSettings(epmSettings, false);
		if (allEpmSettings === null) {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(current, "startScheduledImport: invalid configuration");
			return;
		}

		if (allEpmSettings.useISPSSOauth === true) {
			this.logonISPSS(allEpmSettings.ispssEpmTenantUrl, allEpmSettings.oauthEntityProfile, "EPMSNOW", "EPM-IMPORT-01:" + impSet_id); // url, username, password, appid, correlationId
		} else {
			this.logon(allEpmSettings.epmBaseUrl.concat('/EPM/API/Auth/EPM/Logon'), allEpmSettings.username, allEpmSettings.password, "EPMSNOW", "EPM-IMPORT-01:" + impSet_id); // url, username, password, appid, correlationId
		}
	},

	logon: function(url, username, password, appid, correlationId) {
        var sm;
		var httpsHelpers = new HttpsHelpers();
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod("POST");
            sm.setHttpTimeout(apiTimeout * 1000);
			sm.setRequestBody(JSON.stringify({
				"Username": username,
				"Password": password,
				"ApplicationID": appid
			}));

            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			httpsHelpers.setTelemetryHeader(sm);

			sm.setEccParameter('skip_sensor', 'true');
			sm.setEccCorrelator(correlationId);
			sm.setEccTopic(correlationId);
            sm.executeAsync();
        } catch (ex) {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(null, "Error in logon: " + ex.message);
        }
    },

	logonISPSS: function(ispssEpmTenantUrl, oauthEntityProfile, appid, correlationId) {
        var sm;
		var httpsHelpers = new HttpsHelpers();
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {

			sm = new sn_ws.RESTMessageV2();
			sm.setEndpoint(ispssEpmTenantUrl);
			sm.setHttpMethod('get');

			// This tells ServiceNow to fetch the OAuth token linked to this Alias
			sm.setAuthenticationProfile('oauth2', oauthEntityProfile);
			sm.setRequestorProfile(appid + "-" + correlationId);
            sm.setHttpTimeout(apiTimeout * 1000);

            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
			httpsHelpers.setTelemetryHeader(sm);

			sm.setEccParameter('skip_sensor', 'true');
			sm.setEccCorrelator(correlationId);
			sm.setEccTopic(correlationId);
            sm.executeAsync();
        } catch (ex) {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(null, "Error in logonISPSS: " + ex.message + " - " + ex.stack);
        }
    },

	processLogon: function(current) {
		var xmlDoc = new XMLDocument2();
		xmlDoc.parseXML(current.payload);
		var http_status_code = xmlDoc.getNode("//parameters/parameter[@name='http_status_code']").getAttribute("value");
		var output = xmlDoc.getNodeText("//results/result/output");
		var node = xmlDoc.getNode("//results");
		AsyncHttpsHelpers.storageMap["logon.http_status_code"] = http_status_code;
		AsyncHttpsHelpers.storageMap["logon.output"] = output;
		AsyncHttpsHelpers.storageMap["logon.error"] = node.getAttribute("error");
	},

    // Helper function to make https POST call to retrieve detailed raw events
    makeHttpsPostCall: function(url, method, token, body, correlationId) {
        gs.info("URL: " + url + "\nmethod: " + method + "\ncorrelationId: " + correlationId + "\ntoken: " + token);
        var requestBody;
        var sm;
		var httpsHelpers = new HttpsHelpers();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {
			//initialize request
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod(method);
            sm.setHttpTimeout(apiTimeout * 1000);
            sm.setRequestHeader('Authorization', 'Basic '.concat(token));
            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			httpsHelpers.setTelemetryHeader(sm);
            sm.setRequestBody(JSON.stringify(body));
            // Execute request
			sm.setEccParameter('skip_sensor', 'true');
			sm.setEccCorrelator(correlationId);
			sm.setEccTopic(correlationId);
            sm.executeAsync();
        }catch (ex) {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(null, "The API request for makeHttpsPostCall failed" + ex.getMessage());
        }
    },

    // Helper function to make ISPSS https POST call to retrieve detailed raw events
    makeISPSSHttpsPostCall: function(url, method, oauthEntityProfile, body, correlationId) {
        // gs.info("URL: " + url + "\nmethod: " + method + "\ncorrelationId: " + correlationId + "\ntoken: " + token);
        var requestBody;
        var sm;
		var httpsHelpers = new HttpsHelpers();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {


			sm = new sn_ws.RESTMessageV2();
			sm.setEndpoint(url);
			sm.setHttpMethod(method);

			// This tells ServiceNow to fetch the OAuth token linked to this Alias
			sm.setAuthenticationProfile('oauth2', oauthEntityProfile);
			sm.setRequestorProfile(correlationId);
            sm.setHttpTimeout(apiTimeout * 1000);

            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
			httpsHelpers.setTelemetryHeader(sm);
            sm.setRequestBody(JSON.stringify(body));
            // Execute request
			sm.setEccParameter('skip_sensor', 'true');
			sm.setEccCorrelator(correlationId);
			sm.setEccTopic(correlationId);
            sm.executeAsync();
        }catch (ex) {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(null, "The API request for makeISPSSHttpsPostCall failed" + ex.getMessage());
        }
    },


    type: 'AsyncHttpsHelpers'
};

AsyncHttpsHelpers.storageMap = new Map();
