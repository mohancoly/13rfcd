<name>sys_script_include_0bcaf5b587b53090dea3da083cbb3526</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.PolicyBodyBuilders&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;true&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;PolicyBodyBuilders&lt;/name&gt;&lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var PolicyBodyBuilders = Class.create();
PolicyBodyBuilders.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	isEmptyOrWhitespaceOrNull: function(str) {
        return str === null || str === undefined || str.trim() === '';
    },

	// Builds and returns policy body for Manual Requests
	jitBody2 : function(name, justification, username, agentId, current){

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var jitKillRunningApps = false;
		epmSettings.query();
		while (epmSettings.next()) {
			jitKillRunningApps = epmSettings.getValue('jit_kill_running_apps') == 1;
		}

        var body = {
            "Duration": current.getValue("jit_duration"),
            "PolicyType": 40,
			"isAppliedtoAllComputers": false,
            "Name": name, 
			"IsActive": true,
            "Audit":true,
            "Justification": justification,
            "KillRunningApps": jitKillRunningApps == true,
            "Executors": [
                {
                    "Id": agentId,
                    "ExecutorType": 1
                }
            ],
            "Accounts": [
                {
                    "SamName": username,
					"DisplayName": username,
					"AccountType": 1
                }
            ],
			"IncludeADComputerGroups": [],
            "TargetLocalGroups": [
                {
					"AccountType": 0,
                    "DisplayName": "Administrators"
                }
            ]
        };

        return body;

    },										

	// Builds AddToPolicy
	addToPolicyBody : function(epmEventUrl, epmToken, current, eventRow){
		var httpsHelpers = new HttpsHelpers();
		var policyDetails = httpsHelpers.makeHttpsPostCall(epmEventUrl, 'GET', epmToken, {}); 

		var policy = JSON.parse(policyDetails.getBody()).Policy;

		var fileNamePattern = {
				"@type" : "FileName",
				"hashAlgorithm" : "SHA1",
				"hash" : eventRow.hash.slice(6),
				"hashSHA256" : "",
				"fileSize" : 0,
				"isEmpty" : false,
				"content" : eventRow.lastEventFileName,
				"compareAs" : 0,
				"caseSensitive" : false
			};
		var locationPattern = {
				"@type" : "Location",
				"content" : eventRow.fileLocation,
				"withSubfolders" : true,
				"caseSensitive" : false,
				"isEmpty" : false
			};
		var publisherPattern = {
				"@type" : "Publisher",
				"signatureLevel" : this.isEmptyOrWhitespaceOrNull(eventRow.publisher)? 1 : 2,
				"separator" : ";",
				"caseSensitive" : true,
				"compareAs" : 0,
				"isEmpty" : true,
				"content" : eventRow.publisher
			};
		var originalFileNamePattern = {
				"@type" : "FileInfo",
				"elementName" : "FileVerInfo",
				"attributeInfoName" : "OriginalFilename",
				"isEmpty" : false,
				"content" : eventRow.lastEventOriginalFileName,
				"compareAs" : 0,
				"caseSensitive" : false
			};
		var clsidPattern = {
				"@type" : "Text",
				"isEmpty" : false,
				"content" : eventRow.CLSID,
				"compareAs" : 0,
				"caseSensitive" : false
			};
		var winAdminTaskPattern = {
				"@type" : "WinAdminTask",
				"isEmpty" : false,
				"taskIds" : [eventRow.aggregatedBy.split(",")[0]]
			};


		var patterns = {};
		// Windows Executable
		switch(eventRow.applicationTypeId) {
			case 3: // Windows Executable
				Object.assign(patterns, {
					"FILE_NAME" : fileNamePattern,
					"LOCATION" : locationPattern,
					"PUBLISHER" : publisherPattern,
					"ORIGINAL_FILE_NAME" : originalFileNamePattern
				});
				break;
			case 8: // Admin Task
				Object.assign(patterns, {
					"ADMIN_TASK_ID" : winAdminTaskPattern
				});
				break;
			case 15: // Windows COM
				Object.assign(patterns, {
					"FILE_NAME" : fileNamePattern,
					"LOCATION" : locationPattern,
					"PUBLISHER" : publisherPattern,
					"CLSID" : clsidPattern
				});
				break;

		}

		gs.info("***patterns: " + JSON.stringify(patterns));


		var application = {
			"applicationType": eventRow.applicationTypeId,
			"displayName": "",
			"description": "",
			"patterns": patterns
		};

		policy.Applications.push(application);

        return policy;

    },										

    type: 'PolicyBodyBuilders'
});]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;drew.lockliear@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2021-08-06 18:48:02&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_id&gt;0bcaf5b587b53090dea3da083cbb3526&lt;/sys_id&gt;&lt;sys_mod_count&gt;42&lt;/sys_mod_count&gt;&lt;sys_name&gt;PolicyBodyBuilders&lt;/sys_name&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy&gt;read&lt;/sys_policy&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_0bcaf5b587b53090dea3da083cbb3526&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;epmtest&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-06-13 16:44:53&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;0bcaf5b587b53090dea3da083cbb3526&lt;/id&gt;&lt;sys_created_by&gt;Edward.Nunez&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2024-10-09 21:00:31&lt;/sys_created_on&gt;&lt;sys_id&gt;8b6d40531b855e509be20d01cd4bcbe2&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;Edward.Nunez&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2024-10-09 21:00:31&lt;/sys_updated_on&gt;&lt;table&gt;sys_script_include&lt;/table&gt;&lt;use_es_latest&gt;false&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
