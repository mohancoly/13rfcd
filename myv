<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;true&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;false&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;ecc_queue&lt;/collection&gt;&lt;condition/&gt;&lt;description/&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="ecc_queue"&gt;topicSTARTSWITHEPM-IMPORT-01:^queue=input^stateINready,error^EQ&lt;item endquery="false" field="topic" goto="false" newquery="false" operator="STARTSWITH" or="false" value="EPM-IMPORT-01:"/&gt;&lt;item display_value="input" endquery="false" field="queue" goto="false" newquery="false" operator="=" or="false" value="input"/&gt;&lt;item display_value="ready,error" endquery="false" field="state" goto="false" newquery="false" operator="IN" or="false" value="ready,error"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;EPM-IMPORT-LOGON&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
    var asyncHttpsHelpers = new AsyncHttpsHelpers();
	asyncHttpsHelpers.processLogon(current);
	asyncHttpsHelpers.debugStorageMap();

	current.state = "processed";
	current.processed = new GlideDateTime();
	// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
	current.status = 1;
	current.setWorkflow(false);
	current.update();
	current.setWorkflow(true);	

	var elements = current.topic.split(":");
	var code = asyncHttpsHelpers.getStoredValue("logon.http_status_code");

	if (code === 403) {
		gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in Business Rules: Create Policy Rule\nRetrying in 60 seconds');
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();		
		epmQueryGeneralHelpers.wait(60000);
		var retry = new GlideRecord('ecc_queue');
		retry.initialize();
		retry.topic = current.response_to.topic;
		retry.name = current.response_to.name;
		retry.queue = 'output';
		retry.agent = current.response_to.agent;
		retry.payload = current.response_to.payload;
		retry.source = current.response_to.source;
		retry.target = current.response_to.target;
		retry.state = 'ready';
		retry.insert();
		current.state = "error";
		current.processed = new GlideDateTime();
		// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
		current.status = 1;
		current.setWorkflow(false);
		current.update();
		current.setWorkflow(true);	
	} else {
		if (code == 200) {
			// Successful Logon it will start with the 
			var asyncEpmQueryGetters = new AsyncEpmQueryGetters();
			asyncEpmQueryGetters.startGetRawEvents(asyncHttpsHelpers.getStoredValue("logon.output"), elements[1]);
		} else {
			var serviceNowUtils = new ServiceNowUtils();
			serviceNowUtils.logError(current, "Cyberark EPM Plugin: " + "Failed to authenticate to EPM =&gt; " + JSON.stringify(asyncHttpsHelpers.getStoredValue("logon.output")));

		}
	}

})(current, previous);]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;edward.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-08-07 19:05:33&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;32524bdc3b5762145cee54ac24e45a54&lt;/sys_id&gt;&lt;sys_mod_count&gt;37&lt;/sys_mod_count&gt;&lt;sys_name&gt;EPM-IMPORT-LOGON&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_32524bdc3b5762145cee54ac24e45a54&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-12-15 18:02:16&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;after&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=32524bdc3b5762145cee54ac24e45a54"/&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;32524bdc3b5762145cee54ac24e45a54&lt;/id&gt;&lt;sys_created_by&gt;edward.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-08-07 19:05:33&lt;/sys_created_on&gt;&lt;sys_id&gt;93338f583b5762145cee54ac24e45a99&lt;/sys_id&gt;&lt;sys_mod_count&gt;1&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-10-16 00:39:52&lt;/sys_updated_on&gt;&lt;table&gt;sys_script&lt;/table&gt;&lt;use_es_latest&gt;false&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
