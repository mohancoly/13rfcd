    processGetRawEvents: function(current) {
		gs.info("=&gt; processGetRawEvents");
		var asyncHttpsHelpers = new AsyncHttpsHelpers();
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();
		var serviceNowUtils = new ServiceNowUtils();


		gs.info(current.payload);
		var xmlDoc = new XMLDocument2();
		xmlDoc.parseXML(current.payload);
		var http_status_code = xmlDoc.getNode("//parameters/parameter[@name='http_status_code']").getAttribute("value");
		var output = xmlDoc.getNodeText("//results/result/output");
		var node = xmlDoc.getNode("//results");

		var elements = current.topic.split(":");
		var currentSetIndex = elements[1];
		var numberOfSets = elements[2];
		var curSetId = elements[3];
		var lastrun_offset = elements[4];
		var impSet_id = elements[5];

		if (http_status_code == 403) {
			gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in Business Rules: Create Policy Rule\nRetrying in 60 seconds');
			epmQueryGeneralHelpers.wait(60000);
			var retry = new GlideRecordSecure('ecc_queue');
			retry.initialize();
			retry.topic = current.response_to.topic;
			retry.name = current.response_to.name;
			retry.queue = 'output';
			retry.agent = current.response_to.agent;
			retry.payload = current.response_to.payload;
			retry.source = current.response_to.source;
			retry.target = current.response_to.target;
			retry.state = 'ready';
			retry.insert();
			current.state = "error";
			current.processed = new GlideDateTime();
			// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
			current.status = 1;
			current.setWorkflow(false);
			current.update();
			current.setWorkflow(true);	

		} else {
			if (http_status_code == 200) {
				var detailedEvents = new Array();
				var parsedDetailedEvents = JSON.parse(output);
				var eventsList = parsedDetailedEvents.events;
				var eventCount = parsedDetailedEvents.returnedCount; // hard limit of 250 events, parameter is limit 1000
				if (eventCount != 0 &amp;&amp; Array.isArray(eventsList)) {
					for (j = 0; j &lt; eventsList.length; j++) {
						if (eventsList[j].processed != true) {
						eventsList[j].SetId = curSetId;
						detailedEvents.push(eventsList[j]);      
						}
					}
				}
				if (detailedEvents.length &gt; 0) {
					// Proceed to insert events in ServiceNow Import Set
					// var snowEvents = epmQueryGeneralHelpers.buildSnowEvents(detailedEvents);
					// gs.info("*** snowEvents: " + JSON.stringify(snowEvents));
					this.insertSnowEvents(detailedEvents, impSet_id); //IMPORT EVENTS INTO METADATA TABLE
				}

				var ga = new GlideAggregate('ecc_queue');
				ga.addQuery('state', 'processed');
				ga.addQuery('queue', 'input');
				ga.addQuery('topic', 'STARTSWITH', 'EPM-IMPORT-02');
				ga.addQuery('topic', 'ENDSWITH', impSet_id);
				ga.addAggregate('COUNT');
				ga.query();

				if (ga.next()) {
					var count = ga.getAggregate('COUNT');
					var factorCount = 0;
					var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
					var enableJustInTimeRequests = false;
					var enableElevationRequests = false;
					epmSettings.query();
					while (epmSettings.next()) {
						enableJustInTimeRequests = epmSettings.getValue('enable_just_in_time_requests') == true;
						enableElevationRequests = epmSettings.getValue('enable_elevation_requests') == true;

					}

					if (enableJustInTimeRequests) {
						factorCount = factorCount + 1;
					}

					if (enableElevationRequests) {
						factorCount = factorCount + 1;
					}		

					gs.info("*** COUNT=" + count + " NUMBEROFSETS=" + numberOfSets + " FACTORCOUNT=" + factorCount);
					if (count == numberOfSets * factorCount) { // if all DETL &amp; AGGR were processed 
						// The last one in the queue. Update the import set to LOADED
						var importSetGR = new GlideRecord('sys_import_set');
						importSetGR.addQuery('sys_id', impSet_id);
						importSetGR.query();

						if (importSetGR.next()) {
						// if (importSetGR.get(impSet_id)) {
							gs.info("**** importSetGR.state=" + importSetGR.state);
							if (importSetGR.getValue("state").toString() === "loading") {
								gs.info("**** CHANGING STATUS OF IMPORT SET TO LOADED");
								importSetGR.state = "loaded";
								importSetGR.load_completed = new GlideDateTime();
								importSetGR.update();
								var transformer = new GlideImportSetTransformer();
								transformer.transformAllMaps(importSetGR);
								if (transformer.isError()) {
									serviceNowUtils.logError(current, '**** Error executing the transform');

								}

								// Update last_run
								var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
								epmSettings.query();
								while (epmSettings.next()) {
									var dateTo = epmSettings.getValue("last_run")? new GlideDateTime(epmSettings.getValue("last_run")) : new GlideDateTime();
									dateTo.add(lastrun_offset); 
									epmSettings.setValue('last_run', dateTo);
									epmSettings.update();
									gs.info('Cyberark EPM Plugin: Changed last_run to ' + dateTo);
								}
							}

						} else {
							serviceNowUtils.logError(current, 'Import Set not found for sys_id: ' + impSet_id);
						}

					}
				}
			} else {
				// Error
				serviceNowUtils.logError(current, "ERROR on ProcessRawEvents: " + http_status_code + " -&gt; " + output);
			}
		}

		gs.info("&lt;= processGetRawEvents");
	},

