<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_ui_action"&gt;&lt;sys_ui_action action="INSERT_OR_UPDATE"&gt;&lt;action_name&gt;retrieve_epm_sets&lt;/action_name&gt;&lt;active&gt;true&lt;/active&gt;&lt;client&gt;false&lt;/client&gt;&lt;client_script_v2&gt;&lt;![CDATA[function onClick(g_form) {

}]]&gt;&lt;/client_script_v2&gt;&lt;comments/&gt;&lt;condition/&gt;&lt;form_action&gt;true&lt;/form_action&gt;&lt;form_button&gt;true&lt;/form_button&gt;&lt;form_button_icon/&gt;&lt;form_button_v2&gt;false&lt;/form_button_v2&gt;&lt;form_context_menu&gt;false&lt;/form_context_menu&gt;&lt;form_link&gt;false&lt;/form_link&gt;&lt;form_menu_button_v2&gt;false&lt;/form_menu_button_v2&gt;&lt;form_style/&gt;&lt;format_for_configurable_workspace&gt;false&lt;/format_for_configurable_workspace&gt;&lt;hint/&gt;&lt;isolate_script&gt;false&lt;/isolate_script&gt;&lt;list_action&gt;false&lt;/list_action&gt;&lt;list_banner_button&gt;false&lt;/list_banner_button&gt;&lt;list_button&gt;false&lt;/list_button&gt;&lt;list_button_icon/&gt;&lt;list_choice&gt;false&lt;/list_choice&gt;&lt;list_context_menu&gt;false&lt;/list_context_menu&gt;&lt;list_link&gt;false&lt;/list_link&gt;&lt;list_save_with_form_button&gt;false&lt;/list_save_with_form_button&gt;&lt;list_style/&gt;&lt;messages/&gt;&lt;name&gt;CyberArk EPM Retrieve Sets&lt;/name&gt;&lt;onclick&gt;getSets()&lt;/onclick&gt;&lt;order&gt;100&lt;/order&gt;&lt;script&gt;&lt;![CDATA[
	var serviceNowUtils = new ServiceNowUtils();

	var propertyValue = gs.getProperty('x_cya_cyberark_epm.disable_async_api_calls');
	var disableAsyncApiCalls = (propertyValue? propertyValue : 'not defined');
	gs.info("*****x_cya_cyberark_epm.disable_async_api_calls: " + (disableAsyncApiCalls? disableAsyncApiCalls : 'not defined'));
	
	if (["true", "enabled"].includes(disableAsyncApiCalls)) {
		gs.info("CyberArk EPM Retrieve Sets: SYNC Method");
		var password = "";
		var username;
		var epmBaseUrl;
		var commaSeperatedSets;
		var httpsHelpers = new HttpsHelpers();

		try {
			var epmSettings = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_settings');
			epmSettings.query();
			while (epmSettings.next()) {
				epmBaseUrl = epmSettings.getValue("epm_login_url");
				username = epmSettings.getValue("epm_api_username");
				commaSeperatedSets = epmSettings.getValue("enabled_epm_sets");
				password = epmSettings.epm_api_password.getDecryptedValue();
			}
		} catch (ex) {
			serviceNowUtils.logError(null, 'UI Action - error in query!', ex);
		} 

		//Log on to EPM
		response = httpsHelpers.makeHttpsCall(epmBaseUrl.concat('/EPM/API/Auth/EPM/Logon'), 'POST', '', username, password, "EPMSNOW");

		if (response.getStatusCode() != 200) {
			serviceNowUtils.logError(null, "Cyberark EPM Plugin: " + "Failed to authenticate to EPM" + "\nURL: " + epmBaseUrl + "\nResponse: " + responseBody);
		}
		if (response.length == 0) {
			serviceNowUtils.logError(null, "Cyberark EPM Plugin: " + "Empty response from Auth. Please check configuration parameters");
		}

		var responseBody = JSON.parse(response.getBody()); //this now holds the XML inside the envelope, as a string
		var epmToken = responseBody.EPMAuthenticationResult;
		var epmManagerUrl = responseBody.ManagerURL;

		var setsResponse = httpsHelpers.makeHttpsCall(epmManagerUrl.concat('/EPM/API/Sets'), 'GET', epmToken, '', '', '');
		var setsResponseBody = JSON.parse(setsResponse.getBody());
		gs.info("EPM GETS SETS BODY: " + JSON.stringify(setsResponseBody));
		gs.info("EPM GETS SETS Count: " + setsResponseBody.SetsCount);
		
		for(i=0;i&lt;setsResponseBody.SetsCount;i++){
		
			gs.info("EPM GETS SETS Current Set Name: " + setsResponseBody.Sets[i].Name + "Current Set ID: " + setsResponseBody.Sets[i].Id);
			var EPMTenantData = new GlideRecord("x_cya_cyberark_epm_cyberark_epm_tenant_data");
			EPMTenantData.addQuery("epm_set_id", setsResponseBody.Sets[i].Id);
			EPMTenantData.setLimit(1);
			EPMTenantData.query();
			if(!EPMTenantData.hasNext()){
				
				var newEPMTenantData = new GlideRecord("x_cya_cyberark_epm_cyberark_epm_tenant_data");
				newEPMTenantData.initialize();
				newEPMTenantData.epm_set_id.setValue(setsResponseBody.Sets[i].Id);
				newEPMTenantData.epm_set_name.setValue(setsResponseBody.Sets[i].Name);
				newEPMTenantData.insert();		
			}	
		}

		action.setRedirectURL(current);
	} else {
		gs.info("CyberArk EPM Retrieve Sets: ASYNC Method");
		var asyncHttpsHelpers = new AsyncHttpsHelpers();
		asyncHttpsHelpers.startLogon("EPM-RETRIEVE-SETS-LOGON");
	}

]]&gt;&lt;/script&gt;&lt;show_form_icon_only&gt;false&lt;/show_form_icon_only&gt;&lt;show_insert&gt;true&lt;/show_insert&gt;&lt;show_list_icon_only&gt;false&lt;/show_list_icon_only&gt;&lt;show_multiple_update&gt;false&lt;/show_multiple_update&gt;&lt;show_query&gt;false&lt;/show_query&gt;&lt;show_update&gt;true&lt;/show_update&gt;&lt;sys_class_name&gt;sys_ui_action&lt;/sys_class_name&gt;&lt;sys_created_by&gt;vlaho&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2021-07-27 17:49:51&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;704d86e687697050dea3da083cbb35df&lt;/sys_id&gt;&lt;sys_mod_count&gt;57&lt;/sys_mod_count&gt;&lt;sys_name&gt;CyberArk EPM Retrieve Sets&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_ui_action_704d86e687697050dea3da083cbb35df&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-03-17 16:27:13&lt;/sys_updated_on&gt;&lt;table&gt;x_cya_cyberark_epm_cyberark_epm_settings&lt;/table&gt;&lt;ui11_compatible&gt;true&lt;/ui11_compatible&gt;&lt;ui16_compatible&gt;true&lt;/ui16_compatible&gt;&lt;/sys_ui_action&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;704d86e687697050dea3da083cbb35df&lt;/id&gt;&lt;sys_created_by&gt;epmtest2&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2024-11-08 17:25:13&lt;/sys_created_on&gt;&lt;sys_id&gt;bddb71bc1bfd5e109be20d01cd4bcb86&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;epmtest2&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2024-11-08 17:25:13&lt;/sys_updated_on&gt;&lt;table&gt;sys_ui_action&lt;/table&gt;&lt;use_es_latest&gt;false&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
