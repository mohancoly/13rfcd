<name>sys_script_include_c0bec0f5fba56a5065a2f7744eefdc63</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.ServiceNowUtils&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;ServiceNowUtils&lt;/name&gt;&lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var ServiceNowUtils = Class.create();
ServiceNowUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	getManagers: function(userId, levels) {
		var managers = [];
		var currentUser = new GlideRecordSecure('sys_user');
		if(currentUser.get(userId));

		for (var i = 0; i &lt; levels; i++) {
			if (currentUser.manager) {
				var manager = new GlideRecordSecure('sys_user');
				if(manager.get(currentUser.manager));
				managers.push({
					level: i + 1,
					name: manager.name,
					email: manager.email
				});
				currentUser = manager;
			} else {
				break;
			}
		}
		return managers;
	},

    logError: function(current, message) {

		// GET ALL ADMINS (users with role)
		var grRole = new GlideRecord('sys_user_role');
		grRole.addQuery('name', "x_cya_cyberark_epm.admin"); 
		grRole.query();
		var roleSysId = null;

		if (grRole.next()) {
			roleSysId = grRole.sys_id;
			gs.info('Role sys_id: ' + roleSysId);
		}

		var adminsList = [];
		var grUserRoles = new GlideRecord('sys_user_has_role');
		grUserRoles.addQuery('role', roleSysId);
		grUserRoles.query();

		while (grUserRoles.next()) {
			if (grUserRoles.user.email) {
				gs.info("***ADMINS:" + grUserRoles.user.email); // This will print the user name
				adminsList.push(grUserRoles.user.email);
			}
		}

		var admins = adminsList.join(",");
		gs.eventQueue("x_cya_cyberark_epm.error_on_logs", current, admins, message, "x_cya_cyberark_epm.log_errors");
		gs.error(message);

	},

    type: 'ServiceNowUtils'
