<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.HttpsHelpers&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;true&lt;/client_callable&gt;&lt;description&gt;Class which contains all helper functions for making https calls to EPM API&lt;/description&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;HttpsHelpers&lt;/name&gt;&lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var HttpsHelpers = Class.create();
HttpsHelpers.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	
	// Helper function to make https call to EPM API to login and return a token
	makeHttpsCall: function(url, method, token, username, password, appid) {
        var response;
        var responseBody;
        var status;
        var sm;

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod(method);
            sm.setHttpTimeout(apiTimeout * 1000);
            if (token == '') {
                sm.setRequestBody(JSON.stringify({
                    "Username": username,
                    "Password": password,
                    "ApplicationID": appid
                }));
            } else {
                sm.setRequestHeader('Authorization', 'Basic '.concat(token));
            }
            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			this.setTelemetryHeader(sm);
			// Initialize request
            response = sm.executeAsync();
			response.waitForResponse(90);
            responseBody = response.haveError() ? response.getErrorMessage() : response.getBody();
            status = response.getStatusCode();
        } catch (ex) {
            responseBody = ex.getMessage();
            status = '500';
        } finally {
            gs.info("makeHttpsCall - URL: " + url + "\nHTTP Status: " + status + "\nResponseBody: " + responseBody);
        }
        return response;
    },

    // Helper function to make https POST call to retrieve detailed raw events
    makeHttpsPostCall: function(url, method, token, body) {
        gs.info("URL: " + url + "\nmethod: " + method + "\ntoken: " + token);
		var serviceNowUtils = new ServiceNowUtils();
        var requestBody;
        var response;
        var responseBody;
        var status;
        var sm;

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {
			//initialize request
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod(method);
            sm.setHttpTimeout(apiTimeout * 1000);
			gs.info("makeHttpPostCall: Using apiTimeout = " + (apiTimeout*1000));
            sm.setRequestHeader('Authorization', 'Basic '.concat(token));
            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			this.setTelemetryHeader(sm);
            sm.setRequestBody(JSON.stringify(body));
            // Execute request
            response = sm.executeAsync();
			response.waitForResponse(90);
            status = response.getStatusCode();
            responseBody = response.getBody();
            requestBody = sm ? sm.getRequestBody() : null;
        }catch (ex) {
            serviceNowUtils.logError(null, "The API request for makeHttpsPostCall failed" + ex.getMessage());				
        } finally {					
            gs.info("makeHttpsPostCall - URL: " + url +"\nMethod: " + method + "\nHTTP Status: " + status + "\nRequest Body: " + requestBody + "\nResponse: " + responseBody);
        }
        return response;
    },

	//HELPER FUNCTION TO HANDLE WHEN LAST RUN IS NOT SET
    makeHttpsPostCallNoDate: function(url, method, token) {
        gs.info("URL: " + url + "\nmethod: " + method + "\ntoken: " + token);
		var serviceNowUtils = new ServiceNowUtils();
        var requestBody;
        var response;
        var responseBody;
        var status;
        var sm;

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod(method);
            sm.setHttpTimeout(apiTimeout * 1000);
            sm.setRequestHeader('Authorization', 'Basic '.concat(token));
            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			this.setTelemetryHeader(sm);
            // Initialize request
            response = sm.executeAsync();
			response.waitForResponse(90);
        } catch (ex) {
            responseBody = ex.getMessage();
            serviceNowUtils.logError(null, "API get detailed raw events failed" + responseBody);
        } finally {
            status = response.getStatusCode();
            responseBody = response.getBody();
            requestBody = sm ? sm.getRequestBody() : null;
            gs.info("makeHttpsPostCallNoDate - URL: " + url + "\nHTTP Status: " + status + "\nRequest Body: " + requestBody + "\nResponse: " + responseBody);

        }
        return response;
    },

    logonForPolicy: function(url, method, token, username, password, appid, body) {
		gs.info("logonForPolicy entered.");
        var requestBody;
        var responseBody;
        var status;
        var sm;
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        try {
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod(method);
            sm.setHttpTimeout(apiTimeout * 1000);
            if (token == '') {
                sm.setRequestBody(JSON.stringify({
                    "Username": username,
                    "Password": password,
                    "ApplicationID": appid
                }));
            } else {
                sm.setRequestHeader('Authorization', 'Basic '.concat(token));
                sm.setRequestBody(JSON.stringify(body));
            }
            sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			this.setTelemetryHeader(sm);

            response = sm.executeAsync();
			response.waitForResponse(90);
            responseBody = response.getBody();
            status = response.getStatusCode();
            if (status === 403) {
                gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in "logonForPolicy" \nRetrying in 60 seconds');
                var recall = true;
                while (recall) {
                    epmQueryGeneralHelpers.wait(60000);
					response = sm.execute();
					responseBody = response.getBody();
					status = response.getStatusCode();
                    if (status !== 403) {
                        recall = false;
                        gs.info('Cyberark EPM Plugin: EPM API Limit retry successful');
                    }
                }
            }
        } catch (ex) {
            responseBody = ex.getMessage();
            status = '500';
        } finally {
            requestBody = sm ? sm.getRequestBody() : null;
            gs.info("logonForPolicy [" + method + "] - URL: " + url + "\nHTTP Status: " + status);
        }
		gs.info("logonForPolicy returned.");
        return response;
    },

    // Helper function to make https call to EPM API WITH token and specify Computer query parameter
    makeCCPCall: function(url, method, cert, appid, safe, object) {
        var requestBody;
        var response;
        var responseBody;
        var status;
        var sm;

		var epmSettings = new GlideRecordSecure('x_cya_cyberark_epm_cyberark_epm_settings');
		var apiTimeout = 30;
		epmSettings.query();
		while (epmSettings.next()) {
			apiTimeout = epmSettings.getValue('api_timeout');
		}

        // 		var filterText = "ComputerName eq '".concat(computer,"'");
        try {
            sm = new sn_ws.RESTMessageV2();
            sm.setEndpoint(url);
            sm.setHttpMethod(method);
            sm.setQueryParameter('AppID', appid);
            sm.setQueryParameter('&amp;Safe', safe);
            sm.setQueryParameter('Object', object);
            sm.setHttpTimeout(apiTimeout * 1000);
            //             sm.setRequestHeader("Accept", "application/json");
            sm.setRequestHeader('Content-Type', 'application/json');
            //             sm.setRequestHeader('User-Agent', 'Mozilla/5.0 (Macintosh; Intel Mac OS X x.y; rv:42.0) Gecko/20100101 Firefox/42.0');
			this.setTelemetryHeader(sm);
			
            // Initialize request
            response = sm.executeAsync();
			response.waitForResponse(90);
            // 			gs.info("REQUEST BODY: ", sm.getRequestBody());
            status = response.getStatusCode();
        } catch (ex) {
            responseBody = ex.getMessage();
            status = '500';
        } finally {
            requestBody = sm ? sm.getRequestBody() : null;
            responseBody = response.getBody();
            gs.info("makeCCPCall - URL: " + url + "\nHTTP Status: " + status + "\nRequest Body: " + requestBody + "\nResponse: " + responseBody);
        }
        return response;
    },

	setTelemetryHeader: function(sm) {
		var headerStr = 'in=endpoint elevation request&amp;iv=2.0&amp;vn=servicenow&amp;it=ITSM';
		var encodedStr = gs.base64Encode(headerStr);
		sm.setRequestHeader("x-cybr-telemetry", encodedStr);
		// gs.info(encodedStr);
	},

    type: 'HttpsHelpers'
});]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;drew.lockliear@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2021-08-03 18:49:48&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_id&gt;866d5e3c87353c50dea3da083cbb35cc&lt;/sys_id&gt;&lt;sys_mod_count&gt;136&lt;/sys_mod_count&gt;&lt;sys_name&gt;HttpsHelpers&lt;/sys_name&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy&gt;read&lt;/sys_policy&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_866d5e3c87353c50dea3da083cbb35cc&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-12-15 18:19:28&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;866d5e3c87353c50dea3da083cbb35cc&lt;/id&gt;&lt;sys_created_by&gt;Edward.Nunez&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2024-10-08 15:32:35&lt;/sys_created_on&gt;&lt;sys_id&gt;f5c87d7a1b8d9a509be20d01cd4bcbe5&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;Edward.Nunez&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2024-10-08 15:32:35&lt;/sys_updated_on&gt;&lt;table&gt;sys_script_include&lt;/table&gt;&lt;use_es_latest&gt;false&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
