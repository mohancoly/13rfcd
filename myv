	// Add your code here
	var serviceNowUtils = new ServiceNowUtils();
    var asyncHttpsHelpers = new AsyncHttpsHelpers();
	asyncHttpsHelpers.processLogon(current);
	asyncHttpsHelpers.debugStorageMap();

	current.state = "processed";
	current.processed = new GlideDateTime();
	// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
	current.status = 1;
	current.setWorkflow(false);
	current.update();
	current.setWorkflow(true);	

	var code = asyncHttpsHelpers.getStoredValue("logon.http_status_code");

	if (code == 403) {
		gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in Business Rules: Create Policy Rule\nRetrying in 60 seconds');
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();		
		epmQueryGeneralHelpers.wait(60000);
		var retry = new GlideRecord('ecc_queue');
		retry.initialize();
		retry.topic = current.response_to.topic;
		retry.name = current.response_to.name;
		retry.queue = 'output';
		retry.agent = current.response_to.agent;
		retry.payload = current.response_to.payload;
		retry.source = current.response_to.source;
		retry.target = current.response_to.target;
		retry.state = 'ready';
		retry.insert();
		current.state = "error";
		current.processed = new GlideDateTime();
		// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
		current.status = 1;
		current.setWorkflow(false);
		current.update();
		current.setWorkflow(true);	
	} else {
		if (code == 200) {
			// Successful Logon it will start with the 
			var asyncEpmQueryGetters = new AsyncEpmQueryGetters();
			asyncEpmQueryGetters.startRetrieveSets(asyncHttpsHelpers.getStoredValue("logon.output"));
		} else {
			serviceNowUtils.logError(current, "Cyberark EPM Plugin: " + "Failed to authenticate to EPM =&gt; " + JSON.stringify(asyncHttpsHelpers.getStoredValue("logon.error")));
		}
	}	

})(current, previous);
]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;edward.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-09-10 17:38:49&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;8ed3bdd7fbb72a1065a2f7744eefdc59&lt;/sys_id&gt;&lt;sys_mod_count&gt;7&lt;/sys_mod_count&gt;&lt;sys_name&gt;EPM-RETRIEVE-SETS-LOGON&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_8ed3bdd7fbb72a1065a2f7744eefdc59&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-12-15 18:23:01&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;after&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=8ed3bdd7fbb72a1065a2f7744eefdc59"/&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;8ed3bdd7fbb72a1065a2f7744eefdc59&lt;/id&gt;&lt;sys_created_by&gt;edward.nunez@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-09-10 17:38:47&lt;/sys_created_on&gt;&lt;sys_id&gt;8475b5dbfbb72a1065a2f7744eefdc7a&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;edward.nunez@cyberark.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-09-10 17:38:47&lt;/sys_updated_on&gt;&lt;table&gt;sys_script&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
