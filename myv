<name>sysevent_in_email_action_f7e261cc3b71f6105cee54ac24e45aea</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sysevent_in_email_action"&gt;&lt;sysevent_in_email_action action="INSERT_OR_UPDATE"&gt;&lt;action&gt;record_action&lt;/action&gt;&lt;active&gt;true&lt;/active&gt;&lt;assignment_operator/&gt;&lt;condition_script/&gt;&lt;description/&gt;&lt;event_name&gt;email.read&lt;/event_name&gt;&lt;filter_condition table="sys_email"&gt;subjectENDSWITHApprove^ORsubjectENDSWITHReject^EQ&lt;item endquery="false" field="subject" goto="false" newquery="false" operator="ENDSWITH" or="false" value="Approve"/&gt;&lt;item endquery="false" field="subject" goto="false" newquery="false" operator="ENDSWITH" or="true" value="Reject"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;from/&gt;&lt;name&gt;Approve/Reject Request&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;reply_email/&gt;&lt;required_roles/&gt;&lt;script&gt;&lt;![CDATA[(function runAction(/*GlideRecord*/ current, /*GlideRecord*/ event, /*EmailWrapper*/ email, /*ScopedEmailLogger*/ logger, /*EmailClassifier*/ classifier) {

if (current.request_state == "requested") {
	gs.info("**** APPROVE INBOUND EMAIL ACTION [" + current.request_state + "]: " + email.subject );
	if (email.subject.indexOf("Approve") &gt;= 0) {
		// current.state = "approved";
		current.request_state = "in_process";
		current.setWorkflow(true); // enables execution for Create Policy Business Rule
		// current.update();

	}

	if (email.subject.indexOf("Reject") &gt;= 0) {
		current.request_state = "closed_rejected";
		current.setWorkflow(true); // enables execution for Create Policy Business Rule
	}

	current.comments = "reply from: " + email.from + "\n\n" + email.body_text;
