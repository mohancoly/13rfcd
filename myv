<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;true&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;false&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;ecc_queue&lt;/collection&gt;&lt;condition/&gt;&lt;description/&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="ecc_queue"&gt;topicSTARTSWITHEPM-CREATE-POLICY-LOGON:^queue=input^stateINready,error^EQ&lt;item endquery="false" field="topic" goto="false" newquery="false" operator="STARTSWITH" or="false" value="EPM-CREATE-POLICY-LOGON:"/&gt;&lt;item display_value="input" endquery="false" field="queue" goto="false" newquery="false" operator="=" or="false" value="input"/&gt;&lt;item display_value="ready,error" endquery="false" field="state" goto="false" newquery="false" operator="IN" or="false" value="ready,error"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;EPM-CREATE-POLICY-LOGON&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	var serviceNowUtils = new ServiceNowUtils();
    var asyncHttpsHelpers = new AsyncHttpsHelpers();
	asyncHttpsHelpers.processLogon(current);
	asyncHttpsHelpers.debugStorageMap();

	current.state = "processed";
	current.processed = new GlideDateTime();
	// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
	current.status = 1;
	current.setWorkflow(false);
	current.update();
	current.setWorkflow(true);	

	var code = asyncHttpsHelpers.getStoredValue("logon.http_status_code");

	if (code == 403) {
		gs.info('Cyberark EPM Plugin: EPM API Request Limit Reached in Business Rules: Create Policy Rule Logon\nRetrying in 60 seconds');
		var epmQueryGeneralHelpers = new EpmQueryGeneralHelpers();		
		epmQueryGeneralHelpers.wait(60000);
		var retry = new GlideRecord('ecc_queue');
		retry.initialize();
		retry.topic = current.topic;
		retry.name = current.name;
		retry.queue = 'output';
		retry.agent = current.agent;
		retry.payload = current.payload;
		retry.source = current.source;
		retry.target = current.target;
		retry.state = 'ready';
		retry.insert();
		current.state = "error";
		current.processed = new GlideDateTime();
		// Recommendation based on article: https://support.servicenow.com/kb?id=kb_article_view&amp;sysparm_article=KB0715782
		current.status = 1;
		current.setWorkflow(false);
		current.update();
		current.setWorkflow(true);	
	} else {
		if (code == 200) {
			// Successful Logon it will start with the 
			var asyncEpmQueryGetters = new AsyncEpmQueryGetters();
			var elements = current.topic.split(":");
			gs.info("Elements: " + elements);
			var currentRequestId = elements[1];

			asyncEpmQueryGetters.startCreatePolicy(asyncHttpsHelpers.getStoredValue("logon.output"), currentRequestId);
		} else {
			serviceNowUtils.logError(current, "Cyberark EPM Plugin: " + "Failed to authenticate to EPM =&gt; " + JSON.stringify(asyncHttpsHelpers.getStoredValue("logon.output")));
		}
