   if (isLoading || newValue === '') {
      return;
   }

   // between 10 and 90
   if (newValue &lt; 10 || newValue &gt; 90) {
		g_form.setValue('api_timeout', oldValue);
		g_form.showFieldMsg('api_timeout', "Invalid value for API timeout. It must be between 10 and 90");
