<name>sys_script_include_c66536891b7578909be20d01cd4bcbb0</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;x_cya_cyberark_epm.LoggingService&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;true&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;LoggingService&lt;/name&gt;&lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var LoggingService = Class.create();
LoggingService.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	
	// Log info to App Logs if username or password is undefined
	credentials: function(username, password) {
		if (username == undefined){
			gs.info("CyberArk EPM Plugin: Username in EPM Settings is undefined...Please set value and re-run");
		}
		if (password == undefined){
			gs.info("CyberArk EPM Plugin: Password in EPM Settings is undefined...Please set value and re-run");
		}
	},
	sets: function(set) {
		if (set == null) {
			gs.info("no sets defined");
		}
		if (set == undefined){
			gs.info("CyberArk EPM Plugin: Enabled EPM Sets in EPM Settings is undefined...Please set value and re-run");
		}
		if (set.length &lt; 1){
			gs.info("CyberArk EPM Plugin: Enabled EPM Sets in EPM Settings is undefined...Please set value and re-run");
		}
	},
    type: 'LoggingService'
});]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;drew.lockliear@cyberark.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2021-08-04 15:23:12&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;false&lt;/sys_customer_update&gt;&lt;sys_id&gt;c66536891b7578909be20d01cd4bcbb0&lt;/sys_id&gt;&lt;sys_mod_count&gt;6&lt;/sys_mod_count&gt;&lt;sys_name&gt;LoggingService&lt;/sys_name&gt;&lt;sys_package display_value="Cyberark-EPM-Plugin-Manual-Request" source="x_cya_cyberark_epm"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_package&gt;&lt;sys_policy&gt;read&lt;/sys_policy&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Cyberark-EPM-Plugin-Manual-Request"&gt;1b03fb1b1b0864500d02b9dcdd4bcb9f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_c66536891b7578909be20d01cd4bcbb0&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;Edward.Nunez&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2023-05-25 06:45:05&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;/record_update&gt;</payload>
