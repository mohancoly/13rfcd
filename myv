<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script_client"&gt;&lt;sys_script_client action="INSERT_OR_UPDATE"&gt;&lt;active&gt;true&lt;/active&gt;&lt;applies_extended&gt;false&lt;/applies_extended&gt;&lt;condition/&gt;&lt;description/&gt;&lt;field&gt;level_managerial_hierarchy_approvers&lt;/field&gt;&lt;global&gt;true&lt;/global&gt;&lt;isolate_script&gt;true&lt;/isolate_script&gt;&lt;messages/&gt;&lt;name&gt;Managerial Level Setting Validation&lt;/name&gt;&lt;order/&gt;&lt;script&gt;&lt;![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

    var re = /^(0|[1-9]\d*)$/; // Regular expression for positive integers

    if (!re.test(newValue)) {
		g_form.setValue('level_managerial_hierarchy_approvers', oldValue);
		g_form.showFieldMsg('level_managerial_hierarchy_approvers', "Invalid value. Please enter a positive integer.");
    } else {
		g_form.hideFieldMsg('level_managerial_hierarchy_approvers');
	}
}
