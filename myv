<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_transform_map"&gt;&lt;sys_transform_map action="INSERT_OR_UPDATE"&gt;&lt;active&gt;true&lt;/active&gt;&lt;copy_empty_fields&gt;false&lt;/copy_empty_fields&gt;&lt;create_new_record_on_empty_coalesce_fields&gt;false&lt;/create_new_record_on_empty_coalesce_fields&gt;&lt;enforce_mandatory_fields&gt;No&lt;/enforce_mandatory_fields&gt;&lt;name&gt;CyberArk EPM Transform Map&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;run_business_rules&gt;true&lt;/run_business_rules&gt;&lt;run_script&gt;true&lt;/run_script&gt;&lt;script&gt;&lt;![CDATA[(function transformRow(source, target, map, log, isUpdate) {

    var getUserNameReference = function(username) {
        var s = username.split("\\");
        return s[s.length - 1];

    };

	var getManagers = function(userId, levels) {
		gs.info("getManagers: UserID=" + userId + " Levels:" + levels);
		var managers = [];
		if (levels &gt; 0) {
			var currentUser = new GlideRecordSecure('sys_user');
			if(currentUser.get(userId));

			for (var i = 0; i &lt; levels; i++) {
				if (currentUser.manager) {
					var manager = new GlideRecordSecure('sys_user');
					if(manager.get(currentUser.manager));
					managers.push(manager.email);
					currentUser = manager;
				} else {
					break;
				}
			}
			gs.info("MANAGERS: " + managers.join(","));
		}
		return managers;
	};

    target.justification = source.getValue("u_justification") ;
    target.processed = true;
	//TODO Set default justification if none provided
    if (source.getValue("u_justification") === null){
        gs.warn("Cyberark EPM Plugin: " + "Justification is null...\nSetting default Justification");
		target.justification = 'User did NOT provide Justification';
    }
    // Get sys_id of meta data to add to the request to reference later
    var priority = 3;
    var dueDate = 6;

    var epmSettings = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_settings');
	var jitDefaultDuration = 1;
	var enabledTicketingValidation = false;
	var ticketPrefix = "";
	var levelManagerialHierarchyApprovers = 0;
	var allowApproversListCustomization = false;
    epmSettings.query();
    while (epmSettings.next()) {
        jitDefaultDuration = epmSettings.getValue('jit_default_duration');
		enabledTicketingValidation = epmSettings.getValue("enable_ticketing_validation") == 1;
		ticketPrefix = epmSettings.getValue("ticket_prefix");
		levelManagerialHierarchyApprovers = epmSettings.getValue("level_managerial_hierarchy_approvers");
		allowApproversListCustomization = epmSettings.getValue("allow_approvers_list_customization") == 1;
    }

	if (source.getValue('u_eventtype') == "ManualRequest") {
		var gr = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_metadata');
		var willskip = false;
		gr.addQuery('filequalifier', source.getValue('u_filequalifier'));
		gr.addQuery('agentid', source.getValue('u_agentid'));  //this was added by Ed on 7/22/2023 to filter by eventid and agentid to workaround the duplicated record issue
		gr.addQuery('user', source.getValue('u_user'));
		gr.addQuery('eventid', source.getValue('u_eventid'));
		gr.addQuery('justification', source.getValue('u_justification'));
		
		gr.query();
		while (gr.next()) {
			if (gr.getValue('processed')==true  ){
				willskip = true;
				gs.warn("Cyberark EPM Plugin: " + "Duplicated not added");
			} else {
				gr.setValue('processed',true);
			}
		}
		if (willskip){
			gs.warn("Cyberark EPM Plugin: " + "Duplicated not added");
			ignore = true;
			return;
		}
	}
    source.setValue("u_processed",true);
	
    dueDate = dueDate &lt;= 12 ? dueDate: 12;

    if (source.getValue("u_eventtype")!= null) {

        gr = new GlideRecord('x_cya_cyberark_epm_cyberark_epm_request');

        var publisher = source.getValue("u_publisher") == null ? '' : source.getValue("u_publisher");
        var packageName = source.getValue("u_packagename") == null ? '' : source.getValue("u_packagename");
        var eventType = source.getValue("u_eventtype");
        var username = source.getValue('u_user');
        var justification= source.getValue("u_justification");

		var updatingEPMRequest = false;
		gs.info("***ISUPDATE: " + isUpdate + " CyberArk_EPM_REQUEST = " + target.cyberark_epm_request);
		if (isUpdate &amp;&amp; eventType == 'ElevationRequest') {
			gr.addQuery('sys_id', target.cyberark_epm_request);
			gr.query();
			if (gr.getRowCount() &gt;= 1) {
				updatingEPMRequest = true;
				gr.next();
				
			} else {
				gr.initialize();
			}
		} else {
			gr.initialize();
		}
        
        if (eventType == 'ElevationRequest'){
            gr.description = "Request from " + source.getValue("u_computer");
			gr.setValue("filepath",source.getValue("u_filepath"));
			gr.setValue("hash",source.getValue('u_hash'));
			gr.setValue("publisher", publisher);
            gr.setValue("application_name", packageName);
			gr.description = "Elevation Request";
			gr.setValue('aggregation_total_events', updatingEPMRequest == true ? parseInt(gr.getValue('aggregation_total_events')) + parseInt(source.getValue('u_totalevents')) : source.getValue('u_totalevents'));
        } else {
            gr.description = "Request for " + (jitDefaultDuration == 1 ? "one hour" : jitDefaultDuration + " hours") + " of local administrator access on " + source.getValue("u_computer");
        }
        // gr.short_description = "Cyberark EPM Plugin";
        gr.short_description = "Request from CyberArk EPM";

//         gr.setValue("special_instructions",'MetaData: '+sysId);
        gr.setValue("priority",priority);
        gr.setValue("hostname",source.getValue('u_computer'));
        gr.setValue("request_type",eventType);

        // var i = 0;
        var finalUser = getUserNameReference(username);

		var usernameField = gs.getProperty('x_cya_cyberark_epm.user_identifier_field');
		gs.info("*****user_identifier_field: " + (usernameField? usernameField : 'user_name'));
		
		var userID = null;

		// attempt to retrieve user record based on EPM username
		var reqFor = new GlideRecord('sys_user');
		// query table
		//finalUser is the sAMAccountName, username is domain\sAMAccountName
		reqFor.addQuery(usernameField? usernameField : 'user_name', finalUser);
		reqFor.orderByDesc("sys_created_on");  
		reqFor.query();
		if (reqFor.next()) {
			userID = reqFor.getUniqueValue();
			gr.setValue('requested_for', reqFor.getUniqueValue());
			gs.warn("debug requested_for =&gt;" + reqFor.getUniqueValue());
		} else {//changed from info to warn, need to change it back
			gs.warn('Cyberark EPM Plugin: ' + 'No mapping from EPM user to ServiceNow user was found. Please correct mapping');
		}

		if (!allowApproversListCustomization) {

			var approversRole = levelManagerialHierarchyApprovers == 0 ? 'x_cya_cyberark_epm.cyberark_epm_request_user' : 'x_cya_cyberark_epm.cyberark_epm_approver_user';
			// var approversRole = 'x_cya_cyberark_epm.cyberark_epm_request_user';

			gs.info("***ApproversRole=" + approversRole);

			// GET ALL APPROVERS (users with role)
			var grRole = new GlideRecord('sys_user_role');
			grRole.addQuery('name', approversRole); 
			grRole.query();
			var roleSysId = null;

			if (grRole.next()) {
				roleSysId = grRole.sys_id;
				gs.info('Role sys_id: ' + roleSysId);
			}

			var approversList = [];
			var grUserRoles = new GlideRecord('sys_user_has_role');
			grUserRoles.addQuery('role', roleSysId); // Replace 'your_role_sys_id' with the sys_id of the role you are querying for
			grUserRoles.query();

			while (grUserRoles.next()) {
				if (grUserRoles.user.email) {
					gs.info("***APPROVER:" + grUserRoles.user.email); // This will print the user name
					approversList.push(grUserRoles.user.email);
				}
			}
			var mergedList = approversList.concat(getManagers(userID, levelManagerialHierarchyApprovers));
			var approvers = mergedList.filter(function(item, index) {
				return mergedList.indexOf(item) === index;
			});
			gr.setValue("approvers_list", approvers.join(","));
		} else {
			gr.setValue("approvers_list", target.approvers_list);
		}

        gr.setValue("username", finalUser);
        gr.setValue("request_for",username);
        gr.setValue("justification",source.getValue("u_justification"));
		gr.setValue("jit_duration", jitDefaultDuration);
		gr.setValue("setid", source.getValue("u_setid"));
		gr.setValue("eventrow", source.getValue("u_eventrow"));

		if (enabledTicketingValidation) {
			var regExp = new RegExp("^(" + ticketPrefix + ")[^\\s,;:-=\\+]+");
			var ticketValue = regExp.exec(source.getValue("u_justification"));
			if (ticketValue &amp;&amp; ticketValue.length &gt; 0) {
				gs.info("TICKET VALUE: " + ticketValue[0]);
				gr.setValue("ticket_number", ticketValue[0]);
			}
		}

        gr.request_state = 'requested';
        gr.approval = 'not requested';
        
        var gtime1 = new GlideTime();
        if (dueDate &lt; 10){
            gtime1.setValue("0" + dueDate + ":00:00");
        } else {
            gtime1.setValue(dueDate + ":00:00");
        }
        var time = new GlideDateTime();
        time.getLocalTime();
        time.add(gtime1);
        
        gr.setValue('due_date',time);
        
		if (updatingEPMRequest == true) {
			gr.update();
			gs.info("Cyberark EPM Plugin: Updated Request [" + gr.cyberark_epm_request) + "]";
		} else {
			gr.insert();
			target.setValue('cyberark_epm_request', gr.sys_id);
			gs.info("Cyberark EPM Plugin: Created Request [" + gr.sys_id + "]");

		}
